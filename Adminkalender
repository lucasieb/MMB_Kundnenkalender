<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MietMichBox – Admin Kalender</title>
  <style>
    :root{
      --mmb-primary:#3b3b3b; --mmb-accent:#0EA5E9; --mmb-bg:#2f2f2f;
      --mmb-muted:#464646; --mmb-ok:#10b981; --mmb-warn:#f59e0b;
      --mmb-busy:#ef4444; --mmb-border:#4f4f4f; --mmb-text:#e5e7eb; --mmb-text-light:#b7b7b7;
      --mmb-shell-padding:0px;
    }
    @media (max-width:900px){ :root{ --mmb-shell-padding:18px; } }
    body{margin:0;min-height:100vh;background:#3b3b3b;font-family:'Poppins',sans-serif;color:var(--mmb-text);display:flex;}
    #mmb-admin-shell{flex:1;min-height:100vh;display:flex;}
    #mmb-admin-cal{flex:1;display:flex;padding:var(--mmb-shell-padding);box-sizing:border-box;min-height:0;}
    #mmb-admin-cal>.mmb-widget{flex:1;display:flex;flex-direction:column;gap:1rem;padding:1.5rem 0;background:transparent;border-radius:0;box-shadow:none;border:none;min-height:100vh;}
    @media (max-width:900px){#mmb-admin-cal>.mmb-widget{padding:1.25rem;}}
    .mmb-loading{display:flex;justify-content:center;align-items:center;height:200px;font-size:.9rem;color:var(--mmb-text-light);}
    .mmb-admin-controls{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
    .mmb-box-buttons{display:flex;gap:.5rem;flex-wrap:wrap;}
    .mmb-box-btn{background:var(--mmb-bg);border:1px solid var(--mmb-border);color:var(--mmb-text);padding:.75rem 1rem;border-radius:4px;cursor:pointer;font-size:.875rem;font-weight:500;min-width:140px;}
    .mmb-box-btn:hover{background:var(--mmb-muted);} .mmb-box-btn--active{background:var(--mmb-accent);color:#fff;border-color:var(--mmb-accent);}
    .mmb-nav{display:flex;align-items:center;gap:1rem;margin-left:auto;}
    .mmb-nav-btn{background:var(--mmb-bg);border:1px solid var(--mmb-border);color:var(--mmb-text);padding:.5rem .75rem;border-radius:4px;cursor:pointer;}
    .mmb-month-title{font-weight:600;}
    .mmb-right{display:flex;align-items:center;gap:12px;margin-left:auto;}
    .mmb-block-mode{display:flex;align-items:center;gap:.5rem;background:var(--mmb-muted);padding:.5rem;border-radius:4px;}
    .mmb-block-toggle{background:var(--mmb-busy);color:#fff;border:none;padding:.5rem 1rem;border-radius:4px;cursor:pointer;}
    .mmb-block-toggle--active{background:var(--mmb-ok);}
    .mmb-switch-row{display:flex;align-items:center;gap:.5rem;background:var(--mmb-muted);padding:.5rem;border-radius:4px;}
    .mmb-switch{display:inline-flex;align-items:center;}
    .mmb-switch input{width:42px;height:22px;appearance:none;background:#ddd;border-radius:999px;position:relative;cursor:pointer;transition:.2s;outline:none;}
    .mmb-switch input:checked{background:#0EA5E9;}
    .mmb-switch input::after{content:'';position:absolute;left:3px;top:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.2s;}
    .mmb-switch input:checked::after{transform:translateX(20px);}
    .mmb-calendar{border:1px solid var(--mmb-border);border-radius:6px;overflow:hidden;}
    .mmb-calendar-header{display:grid;grid-template-columns:repeat(7,1fr);background:var(--mmb-muted);}
    .mmb-day-header{padding:.75rem .5rem;text-align:center;font-weight:600;font-size:.875rem;border-right:1px solid var(--mmb-border);} .mmb-day-header:last-child{border-right:none;}
    .mmb-calendar-body{display:grid;grid-template-columns:repeat(7,1fr);}
    .mmb-day{border-right:1px solid var(--mmb-border);border-bottom:1px solid var(--mmb-border);padding:0;cursor:pointer;display:flex;align-items:center;justify-content:center;min-height:72px;}
    .mmb-day:nth-child(7n){border-right:none;}
    .mmb-day--other-month{color:var(--mmb-text-light);opacity:.5;}
    .mmb-day--available{background:var(--mmb-bg);} .mmb-day--busy{background:#fee2e2;color:#991b1b;} .mmb-day--blocked{background:#f3f4f6;color:var(--mmb-text-light);cursor:not-allowed;}
    .mmb-error{margin-top:1rem;padding:1rem;border-radius:6px;background:#fee2e2;color:#b91c1c;font-weight:600;}

    .mmb-calendar-heading{font-size:1.25rem;margin:0;}
    .mmb-calendar-note{margin:0;line-height:1.45;font-size:.85rem;color:var(--mmb-text-light);}
    .mmb-box-select,.mmb-back-link{display:none;}
    .mmb-calendar-legend{display:flex;gap:1rem;font-size:.85rem;}
    .mmb-calendar-legend span::before{content:'';display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:.4rem;background:var(--mmb-accent);}
    .mmb-calendar-legend .is-busy::before{background:#f87171;}
    .mmb-nav-btn{min-width:44px;min-height:44px;}
    .mmb-day{cursor:default;}
    @media(max-width:640px){
      :root{--mmb-shell-padding:0px;}
      #mmb-admin-cal{padding:0;min-width:0;}
      #mmb-admin-cal>.mmb-widget{padding:.75rem;gap:.75rem;min-width:0;}
      .mmb-admin-controls{display:block;min-width:0;}
      .mmb-back-link{display:block;min-height:44px;padding:0;border:0;background:transparent;color:#bae6fd;font:inherit;text-align:left;cursor:pointer;}
      .mmb-box-buttons{display:none;}
      .mmb-box-select{display:flex;flex-direction:column;gap:.35rem;font-size:.85rem;}
      .mmb-box-select select{width:100%;min-width:0;min-height:44px;font-size:16px;padding:.5rem;background:var(--mmb-bg);color:var(--mmb-text);border:1px solid var(--mmb-border);border-radius:8px;}
      .mmb-nav{margin:.75rem 0 0;justify-content:space-between;gap:.25rem;}
      .mmb-month-title{font-size:.95rem;}
      .mmb-day{min-height:44px;min-width:0;font-size:.9rem;}
      .mmb-day-header{padding:.5rem 0;font-size:.8rem;}
      .mmb-calendar-note,.mmb-calendar-legend{font-size:.8rem;}
    }
  </style>
</head>
<body>
  <div id="mmb-admin-shell">
    <div id="mmb-admin-cal"></div>
  </div>

  <script src="https://firebrick-squirrel-568721.hostingersite.com/admin_auth.js?v=20261020-mobile1" data-api-base="https://firebrick-squirrel-568721.hostingersite.com/"></script>
  <script>
  /* ============ CORE ============ */
  (function(global){'use strict';
    class EventEmitter{constructor(){this.events={};} on(e,l){(this.events[e]??=[]).push(l);} emit(e,d){(this.events[e]||[]).forEach(l=>l(d));}}
    const Utils={
      MONTH_NAMES:['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'],
      DAY_NAMES:['Mo','Di','Mi','Do','Fr','Sa','So'],
      formatDate(d){const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),da=String(d.getDate()).padStart(2,'0'); return `${y}-${m}-${da}`;},
      formatMonthYear(d){return `${this.MONTH_NAMES[d.getMonth()]} ${d.getFullYear()}`;},
      generateCalendarDays(cur){const y=cur.getFullYear(),m=cur.getMonth(),first=new Date(y,m,1),last=new Date(y,m+1,0);
        const start=(first.getDay()===0?6:first.getDay()-1), days=[], prevLast=new Date(y,m,0);
        for(let i=start-1;i>=0;i--){days.push({date:new Date(y,m-1,prevLast.getDate()-i),otherMonth:true});}
        for(let d=1; d<=last.getDate(); d++){days.push({date:new Date(y,m,d),otherMonth:false});}
        const total=Math.ceil(days.length/7)*7, trailing=total-days.length; for(let d=1; d<=trailing; d++){days.push({date:new Date(y,m+1,d),otherMonth:true});}
        return days;}
    };
    global.MMBCore={events:new EventEmitter(),Utils};
  })(window);

  /* ============ Belegungsübersicht – nur Anzeige ============ */
  const MMB_API_BASE = MMBAdminAuth.getApiBase();
  (function(global){'use strict';
    class AdminCalendar{
      constructor(sel){
        this.root=document.querySelector(sel);
        this.state={month:new Date(),box:'1',availability:{},loading:false,error:''};
        this.boxes=[{id:'1',name:'Marshall Bromley 750'},{id:'2',name:'Teufel Rockster Neo'},{id:'3',name:'Soundboks 4'}];
        this.revision=0;
        this.root.addEventListener('click',e=>{
          const el=e.target.closest('[data-act]'); if(!el) return;
          if(el.dataset.act==='prev') this.changeMonth(-1);
          if(el.dataset.act==='next') this.changeMonth(1);
          if(el.dataset.act==='box'){this.state.box=el.dataset.id;void this.reload();}
          if(el.dataset.act==='retry') void this.reload();
          if(el.dataset.act==='bookings') MMBAdminAuth.focusSection('mmb-admin-list');
        });
        this.root.addEventListener('change',e=>{
          if(e.target.matches('[data-box-select]')){this.state.box=e.target.value;void this.reload();}
        });
        void this.reload();
      }
      async reload(){
        const revision=++this.revision;
        this.state.loading=true;this.state.error='';this.render();
        const month=this.state.month, box=this.state.box;
        const from=MMBCore.Utils.formatDate(new Date(month.getFullYear(),month.getMonth(),1));
        const to=MMBCore.Utils.formatDate(new Date(month.getFullYear(),month.getMonth()+1,0));
        try{
          const query=new URLSearchParams({box_id:box,from,to});
          const response=await fetch(MMB_API_BASE+'calendar_unavailable.php?'+query,{credentials:'omit',cache:'no-store'});
          const data=await response.json();
          if(!response.ok||!data.ok) throw new Error('availability');
          if(revision!==this.revision) return;
          const ranges=[...(data.unavailable?.bookings||[]),...(data.unavailable?.blocks||[])];
          const availability={};
          for(const day of MMBCore.Utils.generateCalendarDays(month)){
            const key=MMBCore.Utils.formatDate(day.date);
            availability[key]=ranges.some(range=>key>=range.start_date&&key<=(range.end_date||range.start_date));
          }
          this.state.availability=availability;
        }catch(_){
          if(revision!==this.revision) return;
          this.state.error='Die Belegung konnte nicht geladen werden.';
        }
        if(revision===this.revision){this.state.loading=false;this.render();}
      }
      changeMonth(offset){
        const date=new Date(this.state.month.getFullYear(),this.state.month.getMonth()+offset,1);
        this.state.month=date;void this.reload();
      }
      render(){
        const title=MMBCore.Utils.formatMonthYear(this.state.month);
        this.root.innerHTML=`<div class="mmb-widget">
          <button class="mmb-back-link" data-act="bookings">↑ Zur Buchungsliste</button>
          <h2 class="mmb-calendar-heading">Belegungsübersicht</h2>
          <p class="mmb-calendar-note">Aus Buchungen und Sperrzeiten · nur Anzeige. Manuelle Belegung bleibt deaktiviert.</p>
          <div class="mmb-admin-controls">
            <div class="mmb-box-buttons">${this.boxes.map(box=>`<button class="mmb-box-btn ${box.id===this.state.box?'mmb-box-btn--active':''}" data-act="box" data-id="${box.id}" aria-pressed="${box.id===this.state.box}">${box.name}</button>`).join('')}</div>
            <label class="mmb-box-select">Musikbox<select data-box-select>${this.boxes.map(box=>`<option value="${box.id}" ${box.id===this.state.box?'selected':''}>${box.name}</option>`).join('')}</select></label>
            <div class="mmb-nav"><button class="mmb-nav-btn" data-act="prev" aria-label="Vorheriger Monat">←</button><div class="mmb-month-title" aria-live="polite">${title}</div><button class="mmb-nav-btn" data-act="next" aria-label="Nächster Monat">→</button></div>
          </div>
          ${this.state.loading?'<div class="mmb-loading" role="status">Belegung wird geladen…</div>':this.state.error?`<div class="mmb-error" role="alert">${this.state.error}<button class="mmb-nav-btn" data-act="retry">Erneut laden</button></div>`:this.renderCalendar()}
          <div class="mmb-calendar-legend"><span>Frei</span><span class="is-busy">Belegt / gesperrt</span></div>
        </div>`;
      }
      renderCalendar(){
        const days=MMBCore.Utils.generateCalendarDays(this.state.month);
        return `<div class="mmb-calendar" role="group" aria-label="Belegung ${MMBCore.Utils.formatMonthYear(this.state.month)}">
          <div class="mmb-calendar-header">${MMBCore.Utils.DAY_NAMES.map(day=>`<div class="mmb-day-header">${day}</div>`).join('')}</div>
          <div class="mmb-calendar-body">${days.map(day=>{
            const key=MMBCore.Utils.formatDate(day.date), busy=!!this.state.availability[key];
            const classes=['mmb-day',busy?'mmb-day--busy':'mmb-day--available'];
            if(day.otherMonth) classes.push('mmb-day--other-month');
            return `<div class="${classes.join(' ')}" aria-label="${day.date.toLocaleDateString('de-DE')}: ${day.otherMonth?'anderer Monat':busy?'belegt oder gesperrt':'frei'}">${day.date.getDate()}</div>`;
          }).join('')}</div></div>`;
      }
    }
    async function start(){
      try{await MMBAdminAuth.ensureSession();new AdminCalendar('#mmb-admin-cal');}
      catch(_){document.querySelector('#mmb-admin-cal').innerHTML='<p class="mmb-error">Die Verwaltung konnte nicht geladen werden. Bitte die Seite neu laden.</p>';}
    }
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else void start();
  })(window);
  </script>
</body>
</html>
