<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MietMichBox – Admin Kalender</title>
  <style>
    :root {
      --admin-bg: #f5f5f5;
      --admin-card-bg: #ffffff;
      --admin-border: #e5e7eb;
      --admin-text: #111827;
      --admin-muted: #6b7280;
      --admin-accent: #0ea5e9;
      --admin-accent-strong: #0284c7;
      --admin-error: #dc2626;
      --admin-success: #16a34a;
      --admin-warning: #f59e0b;
      --admin-radius: 14px;
      --admin-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
    }

    body {
      margin: 0;
      padding: 18px 14px;
      background: var(--admin-bg);
      font-family: 'Poppins', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: var(--admin-text);
    }

    .card {
      width: min(100%, 1120px);
      margin: 0 auto;
      background: var(--admin-card-bg);
      border-radius: var(--admin-radius);
      border: 1px solid var(--admin-border);
      box-shadow: var(--admin-shadow);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-height: 540px;
    }

    .card h1 {
      margin: 0;
      padding: 22px 24px;
      border-bottom: 1px solid var(--admin-border);
      font-size: 1.55rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .card .content {
      flex: 1;
      padding: 22px 24px 28px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .admin-shell {
      position: relative;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .admin-shell__login,
    .admin-shell__content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .admin-shell__content {
      display: none;
    }

    .admin-shell--authenticated .admin-shell__login {
      display: none;
    }

    .admin-shell--authenticated .admin-shell__content {
      display: flex;
    }

    .admin-login-form {
      margin: auto;
      max-width: 360px;
      width: 100%;
      padding: 32px 28px;
      border: 1px solid var(--admin-border);
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 14px 28px rgba(15, 23, 42, 0.08);
      display: flex;
      flex-direction: column;
      gap: 18px;
      text-align: center;
    }

    .admin-login-form__heading h2 {
      margin: 0 0 8px 0;
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--admin-text);
    }

    .admin-login-form__heading p {
      margin: 0;
      font-size: 0.95rem;
      color: var(--admin-muted);
    }

    .admin-login-form__field {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      text-align: left;
      font-size: 0.95rem;
      color: var(--admin-text);
    }

    .admin-login-form__field input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid var(--admin-border);
      font-size: 1rem;
      font-family: inherit;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .admin-login-form__field input:focus {
      outline: none;
      border-color: var(--admin-accent);
      box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.18);
    }

    .admin-login-form button {
      border: none;
      border-radius: 999px;
      background: var(--admin-accent);
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
      padding: 12px 0;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .admin-login-form button:hover:not(:disabled) {
      background: var(--admin-accent-strong);
      transform: translateY(-1px);
    }

    .admin-login-form button:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    .admin-login-form__message {
      min-height: 1.2rem;
      font-size: 0.9rem;
      color: var(--admin-muted);
    }

    .admin-login-form__message.is-error {
      color: var(--admin-error);
    }

    .admin-login-form__message.is-success {
      color: var(--admin-success);
    }

    .admin-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
      justify-content: space-between;
    }

    .admin-toolbar__boxes {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .admin-box-btn {
      background: #fff;
      border: 1px solid var(--admin-border);
      border-radius: 999px;
      padding: 10px 18px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      color: var(--admin-text);
      transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    }

    .admin-box-btn:hover {
      background: var(--admin-accent);
      color: #fff;
      box-shadow: 0 12px 24px rgba(14, 165, 233, 0.18);
    }

    .admin-box-btn.is-active {
      background: var(--admin-accent);
      border-color: transparent;
      color: #fff;
      box-shadow: 0 14px 30px rgba(14, 165, 233, 0.25);
    }

    .admin-toolbar__nav {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .admin-nav-btn {
      background: #fff;
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      width: 40px;
      height: 40px;
      font-size: 1.2rem;
      font-weight: 600;
      cursor: pointer;
      color: var(--admin-text);
      transition: background 0.2s ease;
    }

    .admin-nav-btn:hover {
      background: rgba(14, 165, 233, 0.12);
    }

    .admin-month-title {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .admin-calendar-layout {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 24px;
      min-height: 360px;
    }

    .admin-calendar {
      border: 1px solid var(--admin-border);
      border-radius: 18px;
      overflow: hidden;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    .admin-calendar__weekdays {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      background: #f8fafc;
      text-transform: uppercase;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      color: var(--admin-muted);
      border-bottom: 1px solid var(--admin-border);
    }

    .admin-calendar__weekdays span {
      padding: 12px 10px;
      text-align: center;
      font-weight: 600;
    }

    .admin-calendar__grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      grid-auto-rows: 110px;
      flex: 1;
    }

    .admin-calendar__grid.is-loading {
      opacity: 0.6;
      pointer-events: none;
    }

    .admin-calendar-day {
      position: relative;
      border-right: 1px solid var(--admin-border);
      border-bottom: 1px solid var(--admin-border);
      padding: 10px;
      text-align: left;
      background: #fff;
      color: var(--admin-text);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      transition: background 0.2s ease, box-shadow 0.2s ease;
    }

    .admin-calendar-day:nth-child(7n) {
      border-right: none;
    }

    .admin-calendar-day.is-outside {
      background: #f9fafb;
      color: rgba(17, 24, 39, 0.45);
    }

    .admin-calendar-day.is-busy {
      background: rgba(220, 38, 38, 0.08);
    }

    .admin-calendar-day.is-pending {
      background: rgba(245, 158, 11, 0.12);
    }

    .admin-calendar-day.is-blocked {
      background: rgba(17, 24, 39, 0.08);
      color: #374151;
    }

    .admin-calendar-day.is-selected {
      box-shadow: inset 0 0 0 2px var(--admin-accent);
    }

    .admin-calendar-day:hover {
      background: rgba(14, 165, 233, 0.12);
    }

    .admin-calendar-day__number {
      font-size: 1.2rem;
      font-weight: 600;
    }

    .admin-calendar-day__badge {
      position: absolute;
      top: 8px;
      right: 10px;
      background: var(--admin-accent);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 600;
      border-radius: 999px;
      padding: 2px 8px;
      letter-spacing: 0.02em;
    }

    .admin-calendar__empty {
      grid-column: 1 / span 7;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      color: var(--admin-muted);
    }

    .admin-details {
      border: 1px solid var(--admin-border);
      border-radius: 18px;
      padding: 20px;
      background: #fff;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .admin-details h2 {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 600;
    }

    .admin-details__body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 16px;
      font-size: 0.95rem;
    }

    .admin-details__empty {
      color: var(--admin-muted);
      font-style: italic;
    }

    .admin-booking-card {
      border: 1px solid rgba(14, 165, 233, 0.25);
      border-radius: 16px;
      padding: 14px 16px;
      background: rgba(14, 165, 233, 0.06);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .admin-booking-card strong {
      font-size: 0.95rem;
      color: var(--admin-text);
    }

    .admin-booking-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 0.85rem;
      color: var(--admin-muted);
    }

    .admin-badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 10px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.8rem;
      background: rgba(14, 165, 233, 0.16);
      color: var(--admin-accent-strong);
    }

    .admin-badge.is-warning {
      background: rgba(245, 158, 11, 0.16);
      color: #92400e;
    }

    .admin-badge.is-error {
      background: rgba(220, 38, 38, 0.18);
      color: #991b1b;
    }

    .admin-status {
      font-size: 0.95rem;
      padding: 12px 16px;
      border-radius: 10px;
      background: #f8fafc;
      color: var(--admin-muted);
      border: 1px solid rgba(15, 23, 42, 0.05);
    }

    .admin-status.is-error {
      color: var(--admin-error);
      background: rgba(220, 38, 38, 0.08);
      border-color: rgba(220, 38, 38, 0.12);
    }

    .admin-status.is-success {
      color: var(--admin-success);
      background: rgba(22, 163, 74, 0.08);
      border-color: rgba(22, 163, 74, 0.12);
    }

    code {
      font-family: 'Fira Code', 'SFMono-Regular', Menlo, Consolas, monospace;
      font-size: 0.85em;
      background: rgba(15, 23, 42, 0.05);
      padding: 2px 4px;
      border-radius: 4px;
    }

    small {
      color: var(--admin-muted);
    }

    @media (max-width: 960px) {
      body {
        padding: 16px 12px;
      }

      .card {
        border-radius: 18px;
      }

      .card h1 {
        padding: 20px;
      }

      .card .content {
        padding: 20px;
      }

      .admin-calendar-layout {
        grid-template-columns: 1fr;
      }

      .admin-calendar {
        min-height: 360px;
      }

      .admin-calendar__grid {
        grid-auto-rows: 96px;
      }
    }

    @media (max-width: 720px) {
      body {
        padding: 14px 10px;
      }

      .card {
        min-height: auto;
      }

      .card .content {
        padding: 18px;
      }

      .admin-toolbar {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
      }

      .admin-toolbar__nav {
        justify-content: space-between;
      }

      .admin-calendar__grid {
        grid-auto-rows: 88px;
      }
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Admin – Kalender</h1>
    <div class="content">
      <div id="admin-app" class="admin-app"></div>
    </div>
  </div>

  <script data-api-base="auto">
  (function () {
    if (window.MMBAdminPortal) {
      return;
    }

    const script = document.currentScript;

    function resolveBase() {
      const attr = script ? script.getAttribute('data-api-base') : null;
      const normalizedAttr = attr ? attr.trim() : '';
      const candidates = [];

      if (typeof window.MMB_ADMIN_API_BASE === 'string' && window.MMB_ADMIN_API_BASE.trim() !== '') {
        candidates.push(window.MMB_ADMIN_API_BASE.trim());
      }

      if (normalizedAttr && normalizedAttr.toLowerCase() !== 'auto') {
        candidates.push(normalizedAttr);
      }

      const host = (window.location && window.location.hostname ? window.location.hostname : '').toLowerCase();

      if (host && host !== 'www.mietmichbox.de' && host.endsWith('mietmichbox.de')) {
        candidates.push('https://www.mietmichbox.de/');
      }

      candidates.push('https://www.mietmichbox.de/');

      if (host === 'localhost' || host === '127.0.0.1') {
        candidates.push('./');
      }

      candidates.push('./');

      for (let i = 0; i < candidates.length; i += 1) {
        const candidate = candidates[i];
        if (!candidate) {
          continue;
        }
        try {
          return new URL(candidate, window.location.href);
        } catch (error) {
          // ignore invalid candidate
        }
      }

      return new URL('./', window.location.href);
    }

    const baseUrl = resolveBase();
    const STORAGE_KEY = 'mmb-admin-password';
    const unauthorizedListeners = new Set();

    let storedPassword = '';
    try {
      storedPassword = sessionStorage.getItem(STORAGE_KEY) || '';
    } catch (_) {
      storedPassword = '';
    }

    function setPassword(value) {
      storedPassword = typeof value === 'string' ? value : '';
      try {
        if (storedPassword) {
          sessionStorage.setItem(STORAGE_KEY, storedPassword);
        } else {
          sessionStorage.removeItem(STORAGE_KEY);
        }
      } catch (_) {
        /* ignore storage errors */
      }
    }

    function getPassword() {
      return storedPassword;
    }

    async function validatePassword(candidate) {
      if (!candidate) {
        return false;
      }

      const response = await fetch(new URL('admin_validate_password.php', baseUrl).href, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({ password: candidate }),
        mode: 'cors',
        credentials: 'omit',
      });

      if (response.status === 401) {
        return false;
      }

      if (!response.ok) {
        throw new Error('Serverfehler beim Prüfen des Passworts.');
      }

      const payload = await response.json().catch(() => ({}));
      return !!payload.ok;
    }

    function normalizeBody(body, headers) {
      if (
        !body ||
        typeof body === 'string' ||
        body instanceof String ||
        body instanceof FormData ||
        body instanceof Blob ||
        (typeof ArrayBuffer !== 'undefined' && (body instanceof ArrayBuffer || body instanceof Uint8Array))
      ) {
        return body;
      }

      if (!headers['Content-Type']) {
        headers['Content-Type'] = 'application/json';
      }

      return JSON.stringify(body);
    }

    async function request(path, options = {}) {
      const password = getPassword();
      if (!password) {
        const error = new Error('Kein Passwort gesetzt');
        error.code = 'NO_PASSWORD';
        throw error;
      }

      const headers = Object.assign({ Accept: 'application/json' }, options.headers || {});
      headers['X-Admin-Password'] = password;

      const payload = normalizeBody(options.body, headers);

      const response = await fetch(new URL(path, baseUrl).href, {
        method: options.method || 'GET',
        headers,
        body: payload,
        mode: options.mode || 'cors',
        credentials: 'omit',
      });

      if (response.status === 401) {
        setPassword('');
        unauthorizedListeners.forEach((listener) => {
          try {
            listener();
          } catch (_) {
            /* ignore */
          }
        });
        const error = new Error('Passwort ungültig');
        error.code = 'UNAUTHORIZED';
        throw error;
      }

      if (!response.ok) {
        const text = await response.text();
        const error = new Error('Serverfehler');
        error.code = 'HTTP_ERROR';
        error.status = response.status;
        error.body = text;
        throw error;
      }

      const text = await response.text();
      if (!text) {
        return null;
      }

      try {
        return JSON.parse(text);
      } catch (_) {
        return text;
      }
    }

    function onUnauthorized(listener) {
      if (typeof listener === 'function') {
        unauthorizedListeners.add(listener);
      }
      return () => unauthorizedListeners.delete(listener);
    }

    function renderLogin(container, options) {
      container.innerHTML = '';
      const form = document.createElement('form');
      form.className = 'admin-login-form';
      form.innerHTML = `
        <div class="admin-login-form__heading">
          <h2>${options.title || 'Admin-Zugang'}</h2>
          <p>${options.description || 'Bitte gib das Passwort ein, um fortzufahren.'}</p>
        </div>
        <label class="admin-login-form__field">
          <span>Passwort</span>
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Anmelden</button>
        <p class="admin-login-form__message" aria-live="assertive"></p>
      `;
      container.appendChild(form);

      const input = form.querySelector('input[name="password"]');
      const button = form.querySelector('button[type="submit"]');
      const message = form.querySelector('.admin-login-form__message');

      function setMessage(text, type) {
        if (!message) {
          return;
        }
        message.textContent = text || '';
        message.classList.remove('is-error', 'is-success');
        if (type === 'error') {
          message.classList.add('is-error');
        } else if (type === 'success') {
          message.classList.add('is-success');
        }
      }

      async function handleSubmit(event) {
        event.preventDefault();
        if (!input || !button) {
          return;
        }

        const value = input.value.trim();
        if (!value) {
          setMessage('Bitte Passwort eingeben.', 'error');
          input.focus();
          return;
        }

        button.disabled = true;
        button.textContent = 'Prüfe Passwort …';
        setMessage('', null);

        try {
          const ok = await validatePassword(value);
          if (!ok) {
            setMessage('Passwort ist ungültig.', 'error');
            button.disabled = false;
            button.textContent = 'Anmelden';
            input.focus();
            input.select();
            return;
          }

          setPassword(value);
          setMessage('Erfolgreich angemeldet.', 'success');
          if (typeof options.onSuccess === 'function') {
            await options.onSuccess();
          }
        } catch (error) {
          setMessage(error && error.message ? String(error.message) : 'Unbekannter Fehler.', 'error');
          button.disabled = false;
          button.textContent = 'Anmelden';
        }
      }

      form.addEventListener('submit', handleSubmit);

      if (input) {
        input.focus();
      }

      return {
        setMessage,
        focus() {
          if (input) {
            input.focus();
            input.select();
          }
        },
      };
    }

    function mount(host, options = {}) {
      if (!host) {
        throw new Error('Container fehlt.');
      }

      const shell = document.createElement('div');
      shell.className = 'admin-shell';
      const loginHost = document.createElement('div');
      loginHost.className = 'admin-shell__login';
      const contentHost = document.createElement('div');
      contentHost.className = 'admin-shell__content';

      shell.appendChild(loginHost);
      shell.appendChild(contentHost);

      host.innerHTML = '';
      host.appendChild(shell);

      let cleanupUnauthorized = null;

      async function showApp() {
        shell.classList.add('admin-shell--authenticated');
        contentHost.innerHTML = '';
        if (typeof options.renderApp === 'function') {
          await options.renderApp(contentHost);
        }
      }

      function showLogin(message) {
        shell.classList.remove('admin-shell--authenticated');
        contentHost.innerHTML = '';
        const login = renderLogin(loginHost, {
          title: options.loginTitle,
          description: options.loginDescription,
          async onSuccess() {
            await showApp();
          },
        });
        if (message) {
          login.setMessage(message, 'error');
        }
      }

      cleanupUnauthorized = onUnauthorized(() => {
        showLogin('Bitte Passwort erneut eingeben.');
      });

      showLogin();

      const existing = getPassword();
      if (existing) {
        validatePassword(existing)
          .then((ok) => {
            if (ok) {
              showApp();
            } else {
              setPassword('');
            }
          })
          .catch(() => {
            setPassword('');
          });
      }

      return {
        destroy() {
          if (cleanupUnauthorized) {
            cleanupUnauthorized();
            cleanupUnauthorized = null;
          }
        },
        refresh() {
          if (shell.classList.contains('admin-shell--authenticated')) {
            showApp();
          }
        },
      };
    }

    window.MMBAdminPortal = {
      mount,
      request,
      validatePassword,
      getPassword,
      setPassword,
      onUnauthorized,
      getApiBase() {
        return baseUrl.href;
      },
    };
  })();
  </script>
  <script>
  (function () {
    const portal = window.MMBAdminPortal;
    const host = document.getElementById('admin-app');
    if (!portal || !host) {
      if (host) {
        host.innerHTML = '<p class="admin-status is-error">Admin-Skript konnte nicht geladen werden.<br/><small>Bitte prüfe die Einbettung oder setze <code>window.MMB_ADMIN_API_BASE</code> auf die Backend-URL.</small></p>';
      }
      return;
    }

    const boxes = [
      { id: 1, name: 'Marshall Bromley 750' },
      { id: 2, name: 'Teufel Rockster Neo' },
      { id: 3, name: 'Soundboks 4' },
    ];

    const state = {
      boxId: boxes[0].id,
      month: startOfMonth(new Date()),
      days: [],
      bookings: [],
      blocks: [],
      selectedIso: null,
      loading: false,
    };

    portal.mount(host, {
      loginTitle: 'Admin-Zugang',
      loginDescription: 'Bitte gib das Passwort ein, um den Administrationskalender zu öffnen.',
      renderApp: async function renderApp(container) {
        container.innerHTML = '';

        const toolbar = document.createElement('div');
        toolbar.className = 'admin-toolbar';

        const boxWrap = document.createElement('div');
        boxWrap.className = 'admin-toolbar__boxes';
        boxes.forEach((box) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'admin-box-btn' + (box.id === state.boxId ? ' is-active' : '');
          btn.textContent = box.name;
          btn.dataset.boxId = String(box.id);
          btn.addEventListener('click', () => {
            if (state.boxId !== box.id) {
              state.boxId = box.id;
              state.selectedIso = null;
              updateBoxButtons();
              loadData();
            }
          });
          boxWrap.appendChild(btn);
        });

        const nav = document.createElement('div');
        nav.className = 'admin-toolbar__nav';
        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.className = 'admin-nav-btn';
        prevBtn.textContent = '‹';
        const monthTitle = document.createElement('div');
        monthTitle.className = 'admin-month-title';
        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.className = 'admin-nav-btn';
        nextBtn.textContent = '›';

        prevBtn.addEventListener('click', () => {
          changeMonth(-1);
        });
        nextBtn.addEventListener('click', () => {
          changeMonth(1);
        });

        nav.appendChild(prevBtn);
        nav.appendChild(monthTitle);
        nav.appendChild(nextBtn);

        toolbar.appendChild(boxWrap);
        toolbar.appendChild(nav);

        const layout = document.createElement('div');
        layout.className = 'admin-calendar-layout';

        const calendar = document.createElement('div');
        calendar.className = 'admin-calendar';
        calendar.innerHTML = `
          <div class="admin-calendar__weekdays">
            <span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span>
          </div>
        `;
        const grid = document.createElement('div');
        grid.className = 'admin-calendar__grid';
        calendar.appendChild(grid);

        const details = document.createElement('div');
        details.className = 'admin-details';
        details.innerHTML = `
          <h2>Details</h2>
          <div class="admin-details__body">
            <p class="admin-details__empty">Bitte wähle einen Tag aus.</p>
          </div>
        `;
        const detailsBody = details.querySelector('.admin-details__body');

        layout.appendChild(calendar);
        layout.appendChild(details);

        const status = document.createElement('div');
        status.className = 'admin-status';
        status.textContent = 'Bereit.';

        container.appendChild(toolbar);
        container.appendChild(layout);
        container.appendChild(status);

        function updateBoxButtons() {
          const buttons = boxWrap.querySelectorAll('button');
          buttons.forEach((button) => {
            const boxId = Number(button.dataset.boxId);
            if (boxId === state.boxId) {
              button.classList.add('is-active');
            } else {
              button.classList.remove('is-active');
            }
          });
        }

        function changeMonth(delta) {
          state.month = startOfMonth(new Date(state.month.getFullYear(), state.month.getMonth() + delta, 1));
          state.selectedIso = null;
          loadData();
        }

        function formatMonthTitle(date) {
          return date.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
        }

        function buildCalendar() {
          const base = startOfMonth(state.month);
          const startWeekday = (base.getDay() + 6) % 7; // Monday first
          const days = [];

          for (let i = startWeekday - 1; i >= 0; i -= 1) {
            const date = new Date(base.getFullYear(), base.getMonth(), 1 - i - 1);
            days.push(createDay(date, false));
          }

          const lastDay = new Date(base.getFullYear(), base.getMonth() + 1, 0);
          for (let day = 1; day <= lastDay.getDate(); day += 1) {
            const date = new Date(base.getFullYear(), base.getMonth(), day);
            days.push(createDay(date, true));
          }

          while (days.length % 7 !== 0) {
            const date = new Date(lastDay.getFullYear(), lastDay.getMonth(), lastDay.getDate() + (days.length % 7));
            days.push(createDay(date, false));
          }

          state.days = days;
        }

        function createDay(date, inMonth) {
          return {
            date,
            iso: toISODate(date),
            inMonth,
            bookings: [],
            blocks: [],
            status: 'free',
          };
        }

        function applyData() {
          const days = state.days;
          days.forEach((day) => {
            day.bookings = [];
            day.blocks = [];
            day.status = 'free';
          });

          (state.bookings || []).forEach((booking) => {
            const start = parseISODate(booking.start_date);
            const end = parseISODate(booking.end_date);
            if (!start || !end) {
              return;
            }
            state.days.forEach((day) => {
              if (day.date >= start && day.date <= end) {
                day.bookings.push(booking);
              }
            });
          });

          (state.blocks || []).forEach((block) => {
            const start = parseISODate(block.start_date);
            const end = parseISODate(block.end_date);
            if (!start || !end) {
              return;
            }
            state.days.forEach((day) => {
              if (day.date >= start && day.date <= end) {
                day.blocks.push(block);
              }
            });
          });

          state.days.forEach((day) => {
            if (day.blocks.length) {
              day.status = 'blocked';
            } else if (day.bookings.some((b) => String(b.status).toLowerCase() === 'confirmed')) {
              day.status = 'busy';
            } else if (day.bookings.length) {
              day.status = 'pending';
            } else {
              day.status = 'free';
            }
          });
        }

        function renderCalendar() {
          monthTitle.textContent = formatMonthTitle(state.month);
          grid.innerHTML = '';
          grid.classList.toggle('is-loading', state.loading);

          if (!state.days.length) {
            grid.innerHTML = '<div class="admin-calendar__empty">Keine Daten verfügbar.</div>';
            return;
          }

          state.days.forEach((day) => {
            const cell = document.createElement('button');
            cell.type = 'button';
            cell.className = 'admin-calendar-day';
            if (!day.inMonth) {
              cell.classList.add('is-outside');
            }
            if (day.status === 'busy') {
              cell.classList.add('is-busy');
            } else if (day.status === 'pending') {
              cell.classList.add('is-pending');
            } else if (day.status === 'blocked') {
              cell.classList.add('is-blocked');
            }
            if (state.selectedIso === day.iso) {
              cell.classList.add('is-selected');
            }

            cell.innerHTML = `
              <span class="admin-calendar-day__number">${day.date.getDate()}</span>
            `;

            if (day.bookings.length) {
              const badge = document.createElement('span');
              badge.className = 'admin-calendar-day__badge';
              badge.textContent = String(day.bookings.length);
              cell.appendChild(badge);
            }

            cell.addEventListener('click', () => {
              state.selectedIso = day.iso;
              renderCalendar();
              renderDetails();
            });

            grid.appendChild(cell);
          });
        }

        function renderDetails() {
          if (!detailsBody) {
            return;
          }
          const day = state.days.find((candidate) => candidate.iso === state.selectedIso);
          if (!day) {
            detailsBody.innerHTML = '<p class="admin-details__empty">Bitte wähle einen Tag aus.</p>';
            return;
          }

          const parts = [];
          parts.push(`<div><strong>${formatLongDate(day.date)}</strong></div>`);

          if (day.blocks.length) {
            const blockList = day.blocks
              .map((block) => {
                const reason = block.reason ? String(block.reason) : 'Blockiert';
                return `<li>${escapeHtml(reason)} (${formatDateRange(block.start_date, block.end_date)})`;
              })
              .join('');
            parts.push(`
              <div>
                <div class="admin-badge is-warning">Blockiert</div>
                <ul>${blockList}</ul>
              </div>
            `);
          }

          if (day.bookings.length) {
            day.bookings.forEach((booking) => {
              const status = String(booking.status || '').toLowerCase();
              const badgeClass = status === 'confirmed'
                ? 'admin-badge is-error'
                : status === 'pending'
                  ? 'admin-badge is-warning'
                  : 'admin-badge';
              const badgeLabel = status ? status.charAt(0).toUpperCase() + status.slice(1) : 'Status';
              parts.push(`
                <div class="admin-booking-card">
                  <div><strong>${escapeHtml(booking.display_id || booking.id || 'Buchung')}</strong></div>
                  <div class="admin-booking-meta">
                    <span class="${badgeClass}">${escapeHtml(badgeLabel)}</span>
                    <span>${escapeHtml(formatDateRange(booking.start_date, booking.end_date))}</span>
                    <span>${escapeHtml(booking.box_name || ('Box #' + (booking.box_id || state.boxId)))}</span>
                  </div>
                  <div>${escapeHtml(booking.customer_name || '–')} &middot; ${escapeHtml(booking.customer_email || '–')}</div>
                  ${booking.customer_phone ? `<div>${escapeHtml(booking.customer_phone)}</div>` : ''}
                  ${booking.fulfillment_label ? `<div>Erfüllung: ${escapeHtml(booking.fulfillment_label)}</div>` : ''}
                </div>
              `);
            });
          } else if (!day.blocks.length) {
            parts.push('<p class="admin-details__empty">Keine Buchungen für diesen Tag.</p>');
          }

          detailsBody.innerHTML = parts.join('');
        }

        function formatDateRange(start, end) {
          const startDate = parseISODate(start);
          const endDate = parseISODate(end);
          if (!startDate || !endDate) {
            return '–';
          }
          const sameDay = startDate.toDateString() === endDate.toDateString();
          const startText = startDate.toLocaleDateString('de-DE');
          const endText = endDate.toLocaleDateString('de-DE');
          return sameDay ? startText : `${startText} – ${endText}`;
        }

        function loadData() {
          if (state.loading) {
            return;
          }
          state.loading = true;
          status.className = 'admin-status';
          status.textContent = 'Lade Kalenderdaten …';
          grid.classList.add('is-loading');

          const range = getMonthRange(state.month);

          Promise.all([
            portal.request(`list_bookings.php?box_id=${state.boxId}&from=${range.from}&to=${range.to}`),
            portal.request(`calendar_unavailable.php?box_id=${state.boxId}&from=${range.from}&to=${range.to}`),
          ])
            .then(([bookingResponse, availabilityResponse]) => {
              if (bookingResponse && bookingResponse.ok === false) {
                throw new Error(bookingResponse.error || 'Buchungen konnten nicht geladen werden.');
              }
              if (availabilityResponse && availabilityResponse.ok === false) {
                throw new Error(availabilityResponse.error || 'Verfügbarkeiten konnten nicht geladen werden.');
              }

              state.bookings = (bookingResponse && bookingResponse.items) || [];
              const unavailable = availabilityResponse && availabilityResponse.unavailable ? availabilityResponse.unavailable : {};
              state.blocks = unavailable.blocks || [];

              buildCalendar();
              applyData();
              renderCalendar();
              renderDetails();

              status.className = 'admin-status is-success';
              status.textContent = `Daten aktualisiert: ${formatTimestamp(new Date())}`;
            })
            .catch((error) => {
              if (error && error.code === 'UNAUTHORIZED') {
                return;
              }
              state.bookings = [];
              state.blocks = [];
              buildCalendar();
              applyData();
              renderCalendar();
              renderDetails();
              status.className = 'admin-status is-error';
              status.textContent = error && error.message ? String(error.message) : 'Kalenderdaten konnten nicht geladen werden.';
            })
            .finally(() => {
              state.loading = false;
              grid.classList.remove('is-loading');
            });
        }

        function formatTimestamp(value) {
          const date = value instanceof Date ? value : new Date(value);
          if (Number.isNaN(date.getTime())) {
            return '–';
          }
          return date.toLocaleString('de-DE', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });
        }

        updateBoxButtons();
        buildCalendar();
        applyData();
        renderCalendar();
        renderDetails();
        loadData();
      },
    });

    function startOfMonth(date) {
      return new Date(date.getFullYear(), date.getMonth(), 1);
    }

    function getMonthRange(date) {
      const start = new Date(date.getFullYear(), date.getMonth(), 1);
      const end = new Date(date.getFullYear(), date.getMonth() + 1, 0);
      return { from: toISODate(start), to: toISODate(end) };
    }

    function toISODate(date) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function parseISODate(value) {
      if (!value) {
        return null;
      }
      const match = /^\d{4}-\d{2}-\d{2}$/.test(String(value));
      if (!match) {
        return null;
      }
      const parts = String(value).split('-').map(Number);
      const date = new Date(parts[0], parts[1] - 1, parts[2]);
      if (Number.isNaN(date.getTime())) {
        return null;
      }
      return date;
    }

    function formatLongDate(date) {
      return date.toLocaleDateString('de-DE', {
        weekday: 'long',
        day: '2-digit',
        month: 'long',
        year: 'numeric',
      });
    }

    function escapeHtml(value) {
      if (value === null || value === undefined) {
        return '';
      }
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }
  })();
  </script>
</body>
