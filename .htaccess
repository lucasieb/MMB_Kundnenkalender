AddDefaultCharset utf-8
<IfModule mod_mime.c>
  AddCharset utf-8 .html .htm .css .js .php
</IfModule>

# The builder embeds this stable URL, so browsers must revalidate it after deploys.
<FilesMatch "^(admin_auth|admin_order|mmb_icons|booking_dates|configurator)\.(js|css)$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header unset Expires
    Header always unset Expires
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </IfModule>
</FilesMatch>

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Echte Dateien/Ordner NIE umschreiben
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # (Falls du ein Frontcontroller/SPA brauchst, hier drunter)
  # RewriteRule . index.php [L]
</IfModule>
