  <script>
  (function(global){'use strict';

    const BOX_MAP = { '1':'Marshall Bromley 750', '2':'Teufel Rockster Neo', '3':'Soundboks 4' };
    const EURO_FORMATTER = new Intl.NumberFormat('de-DE', {maximumFractionDigits:0});
    const FULFILLMENT_CHOICES = [
      {
        id:'pickup',
        label:'Abholung',
        full:'Abholung in Wesel',
        note:'',
        priceDelta:0,
        displaySuffix:'in Wesel',
        infoLines:[
          '📍 Treffpunkt stimmen wir individuell in Wesel ab.',
          '🕚 Abholung ab deinem Miettag um 11:00 Uhr möglich.',
          '🔁 Rückgabe am Folgetag nach Mietende bis 10:00 Uhr.'
        ]
      },
      {
        id:'shipping',
        label:'Versand',
        full:'Versand (deutschlandweit)',
        note:'inkl. Express-Hin- & Rückversand sowie Vorbereitungspauschale',
        priceDelta:80,
        displaySuffix:'ganz.de',
        infoLines:[
          '🚚 Wir versenden die Musikbox einen Tag vor Mietbeginn per Express.',
          '📦 Rückversand am letzten Miettag mit dem beiliegenden QR-Code.',
          '📝 Bitte halte Lieferadresse sowie Kontaktinfos bereit, falls noch nicht übermittelt.'
        ]
      },
      {
        id:'delivery',
        label:'Lieferung',
        full:'Lieferung (NRW-weit)',
        note:'zzgl. individueller Lieferpauschale – wir melden uns mit einem Angebot',
        priceDelta:0,
        displaySuffix:'ganz.nrb',
        infoLines:[
          '🚗 Wir liefern die Musikbox persönlich innerhalb von NRW.',
          '🕒 Wunschzeit am Mittag (halbstündlich) stimmen wir individuell ab.',
          '📍 Bitte teile uns Treffpunkt oder Lieferadresse mit.'
        ]
      }
    ];
    const FULFILLMENT_LOOKUP = Object.fromEntries(FULFILLMENT_CHOICES.map(opt=>[opt.id,opt]));

    const boolish = (value)=>{
      if(typeof value === 'boolean') return value;
      if(typeof value === 'number') return value === 1;
      if(typeof value === 'string'){
        const v = value.trim().toLowerCase();
        if(!v) return null;
        if(['1','true','yes','ja','y','on'].includes(v)) return true;
        if(['0','false','no','nein','off','n'].includes(v)) return false;
      }
      return null;
    };

    const parseFulfillmentDetails = (raw)=>{
      if(!raw) return {};
      if(typeof raw === 'object'){
        try{ return JSON.parse(JSON.stringify(raw)); }catch{return {...raw}; }
      }
      if(typeof raw === 'string'){
        const trimmed = raw.trim();
        if(!trimmed) return {};
        try{
          const parsed = JSON.parse(trimmed);
          return (parsed && typeof parsed === 'object') ? parsed : {};
        }catch(err){ return {}; }
      }
      return {};
    };

    const fulfillmentDisplayLabel = (info)=>{
      const suffix = (info.displaySuffix || '').toString().trim();
      const base = (info.label || info.full || '').toString();
      return suffix ? `${base} (${suffix})` : base;
    };

    const inferFulfillmentMethod = (booking, parsedDetails = {})=>{
      const direct = (booking?.fulfillment_method ?? '').toString().trim().toLowerCase();
      if(['pickup','shipping','delivery'].includes(direct)) return direct;

      const detailSources = [];
      if(parsedDetails && typeof parsedDetails === 'object') detailSources.push(parsedDetails);
      ['fulfillment_details_json','fulfillment_details'].forEach(key=>{
        const raw = booking?.[key];
        if(!raw) return;
        if(typeof raw === 'object'){ detailSources.push(raw); return; }
        if(typeof raw === 'string'){
          try{
            const decoded = JSON.parse(raw);
            if(decoded && typeof decoded === 'object') detailSources.push(decoded);
          }catch(_){}
        }
      });
      for(const candidate of detailSources){
        const method = (candidate?.method ?? '').toString().trim().toLowerCase();
        if(['pickup','shipping','delivery'].includes(method)) return method;
      }

      const textSources = [booking?.fulfillment_label, booking?.fulfillment_note];
      for(const text of textSources){
        if(!text) continue;
        const lower = text.toString().toLowerCase();
        if(lower.includes('versand')) return 'shipping';
        if(lower.includes('liefer')) return 'delivery';
      }

      return 'pickup';
    };

    const fulfillmentInstructionLines = (info, details)=>{
      const base = Array.isArray(info.infoLines) ? info.infoLines.map(x=>String(x).trim()).filter(Boolean) : [];
      const lines = base.slice();
      const contactParts = [];
      const name = (details.contact_name||'').toString().trim();
      const phone = (details.contact_phone||'').toString().trim();
      const email = (details.contact_email||'').toString().trim();
      if(name) contactParts.push(name);
      if(phone) contactParts.push(`Tel: ${phone}`);
      if(email) contactParts.push(`E-Mail: ${email}`);
      const hasContact = contactParts.length>0;
      if(hasContact){ lines.push(`👤 Kontakt: ${contactParts.join(' | ')}`); }

      const consent = boolish(details.consent_contact ?? details.consent_whatsapp);
      if(consent === true){ lines.push('✅ Kontakt per Telefon & WhatsApp ist freigegeben.'); }
      else if(consent === false){ lines.push('⚠️ Bitte nur per E-Mail kontaktieren (kein Telefon/WhatsApp).'); }

      let hasShippingAddress = false;
      if(info.id === 'shipping'){
        const parts = [];
        const line1 = (details.address_line1||'').toString().trim();
        const line2 = (details.address_line2||'').toString().trim();
        const extra = (details.address_extra||'').toString().trim();
        const postal = (details.postal_code||'').toString().trim();
        const city = (details.city||'').toString().trim();
        if(line1) parts.push(line1);
        if(line2) parts.push(line2);
        const cityPart = `${postal} ${city}`.trim();
        if(cityPart) parts.push(cityPart);
        if(extra) parts.push(extra);
        if(parts.length){
          hasShippingAddress = true;
          lines.push(`🏠 Lieferadresse: ${parts.join(', ')}`);
        }
      }

      let hasDeliveryDetails = false;
      if(info.id === 'delivery'){
        const meeting = (details.meeting_point||'').toString().trim();
        const preferred = (details.preferred_time||'').toString().trim();
        if(meeting){
          hasDeliveryDetails = true;
          lines.push(`📍 Treffpunkt: ${meeting}`);
        }
        if(preferred){
          hasDeliveryDetails = true;
          lines.push(`🕒 Wunschzeit (Mittag): ${preferred}`);
        }
      }

      const needsExtra = info.id === 'shipping' || info.id === 'delivery';
      if(needsExtra){
        if(!hasContact){
          lines.push('⚠️ Kein Kontakt für diese Abwicklung hinterlegt – bitte ergänzen.');
        }
        if(!hasShippingAddress && info.id === 'shipping'){
          lines.push('⚠️ Es liegt noch keine vollständige Lieferadresse vor.');
        }
        if(!hasDeliveryDetails && info.id === 'delivery'){
          lines.push('⚠️ Treffpunkt oder Wunschzeit fehlen bislang.');
        }
        if(!hasContact && !hasShippingAddress && !hasDeliveryDetails){
          lines.push('❗ Noch keine zusätzlichen Angaben vom Kunden hinterlegt.');
        }
      }

      return lines;
    };

    // Anzeige-ID (nur Ziffern), Prefix 00 + laufend ab 100
    const ID_CATEGORY = '00';
    function displayId(rawId){ const num = 100 + (Number(rawId)||0); return ID_CATEGORY + String(num).padStart(3,'0'); }

