      if(document.getElementById('mmb-admin-list-css')) return;
      const s=document.createElement('style'); s.id='mmb-admin-list-css'; s.textContent=`
        .mmb-admin-filters{
          display:grid;
          grid-template-columns: repeat(4, minmax(200px, 1fr)) auto;
          gap:.75rem; padding:1rem; background:var(--mmb-muted); border-radius:6px; align-items:center;
        }
        .mmb-admin-filters select,.mmb-admin-filters input{ padding:.6rem;border:1px solid var(--mmb-border);border-radius:6px;background:var(--mmb-bg);color:var(--mmb-text);font-size:.9rem; }
        .mmb-admin-list-wrap{height:70vh;overflow:auto;margin:.75rem 0;border-radius:6px;}
        .mmb-bookings-table{width:100%;border-collapse:collapse;background:var(--mmb-bg);border-radius:6px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.1);}
        .mmb-bookings-table th,.mmb-bookings-table td{padding:.45rem .5rem;border-bottom:1px solid var(--mmb-border);text-align:left;vertical-align:middle;box-sizing:border-box;line-height:1.3;}
