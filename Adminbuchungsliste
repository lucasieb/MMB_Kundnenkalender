  <script>
    document.addEventListener('DOMContentLoaded', async function(){
      let authError = null;
      try {
        await MMBAdminAuth.ensureSession();
      } catch (error) {
        authError = error instanceof Error ? error : new Error(String(error));
        console.warn('Admin-Login wurde übersprungen (externer Schutz aktiv?).', authError);
      } finally {
        syncApiCredentialPreference();
      }

      try {
        MietMichBoxAdminList.init({ container:'#mmb-admin-list', locale:'de-DE', timezone:'Europe/Berlin' });
      } catch (error) {
        console.error('Admin-Buchungsliste konnte nicht initialisiert werden', error);
        const container = document.querySelector('#mmb-admin-list');
        if (container) {
          container.innerHTML = '<p class="mmb-error">Die Buchungsliste konnte nicht geladen werden. Bitte versuchen Sie es erneut oder wenden Sie sich an den Support.</p>';
        }
      }
    });
  </script>
