  <script>
  (function(global){'use strict';

    const BOX_MAP = { '1':'Marshall Bromley 750', '2':'Teufel Rockster Neo', '3':'Soundboks 4' };
    const EURO_FORMATTER = new Intl.NumberFormat('de-DE', {maximumFractionDigits:0});
    const FULFILLMENT_CHOICES = [
      {
        id:'pickup',
        label:'Abholung',
        full:'Abholung in Wesel',
        note:'',
        priceDelta:0,
        displaySuffix:'in Wesel',
        infoLines:[
          '📍 Treffpunkt stimmen wir individuell in Wesel ab.',
          '🕚 Abholung ab deinem Miettag um 11:00 Uhr möglich.',
          '🔁 Rückgabe am Folgetag nach Mietende bis 10:00 Uhr.'
        ]
      },
      {
        id:'shipping',
        label:'Versand',
        full:'Versand (deutschlandweit)',
        note:'inkl. Express-Hin- & Rückversand sowie Vorbereitungspauschale',
        priceDelta:80,
        displaySuffix:'ganz.de',
        infoLines:[
          '🚚 Wir versenden die Musikbox einen Tag vor Mietbeginn per Express.',
          '📦 Rückversand am letzten Miettag mit dem beiliegenden QR-Code.',
          '📝 Bitte halte Lieferadresse sowie Kontaktinfos bereit, falls noch nicht übermittelt.'
        ]
      },
      {
        id:'delivery',
        label:'Lieferung',
        full:'Lieferung (NRW-weit)',
        note:'zzgl. individueller Lieferpauschale – wir melden uns mit einem Angebot',
        priceDelta:0,
        displaySuffix:'ganz.nrb',
        infoLines:[
          '🚗 Wir liefern die Musikbox persönlich innerhalb von NRW.',
          '🕒 Wunschzeit am Mittag (halbstündlich) stimmen wir individuell ab.',
          '📍 Bitte teile uns Treffpunkt oder Lieferadresse mit.'
        ]
      }
    ];
    const FULFILLMENT_LOOKUP = Object.fromEntries(FULFILLMENT_CHOICES.map(opt=>[opt.id,opt]));

    const boolish = (value)=>{
      if(typeof value === 'boolean') return value;
      if(typeof value === 'number') return value === 1;
      if(typeof value === 'string'){
        const v = value.trim().toLowerCase();
        if(!v) return null;
        if(['1','true','yes','ja','y','on'].includes(v)) return true;
        if(['0','false','no','nein','off','n'].includes(v)) return false;
      }
      return null;
    };

    const parseFulfillmentDetails = (raw)=>{
      if(!raw) return {};
      if(typeof raw === 'object'){
        try{ return JSON.parse(JSON.stringify(raw)); }catch{return {...raw}; }
      }
      if(typeof raw === 'string'){
        const trimmed = raw.trim();
        if(!trimmed) return {};
        try{
          const parsed = JSON.parse(trimmed);
          return (parsed && typeof parsed === 'object') ? parsed : {};
        }catch(err){ return {}; }
      }
      return {};
    };

    const fulfillmentDisplayLabel = (info)=>{
      const suffix = (info.displaySuffix || '').toString().trim();
      const base = (info.label || info.full || '').toString();
      return suffix ? `${base} (${suffix})` : base;
    };

    const inferFulfillmentMethod = (booking, parsedDetails = {})=>{
      const direct = (booking?.fulfillment_method ?? '').toString().trim().toLowerCase();
      if(['pickup','shipping','delivery'].includes(direct)) return direct;

      const detailSources = [];
      if(parsedDetails && typeof parsedDetails === 'object') detailSources.push(parsedDetails);
      ['fulfillment_details_json','fulfillment_details'].forEach(key=>{
        const raw = booking?.[key];
        if(!raw) return;
        if(typeof raw === 'object'){ detailSources.push(raw); return; }
        if(typeof raw === 'string'){
          try{
            const decoded = JSON.parse(raw);
            if(decoded && typeof decoded === 'object') detailSources.push(decoded);
          }catch(_){}
        }
      });
      for(const candidate of detailSources){
        const method = (candidate?.method ?? '').toString().trim().toLowerCase();
        if(['pickup','shipping','delivery'].includes(method)) return method;
      }

      const textSources = [booking?.fulfillment_label, booking?.fulfillment_note];
      for(const text of textSources){
        if(!text) continue;
        const lower = text.toString().toLowerCase();
        if(lower.includes('versand')) return 'shipping';
        if(lower.includes('liefer')) return 'delivery';
      }

      return 'pickup';
    };

    const buildFulfillmentDetails = (input, method='pickup')=>{
      const normalizedMethod = (method||'').toString().trim().toLowerCase() || 'pickup';
      let rawDetails;
      if(input && typeof input === 'object' && !Array.isArray(input)){
        if(input.raw && typeof input.raw === 'object'){ rawDetails = parseFulfillmentDetails(input.raw); }
        else if(Object.prototype.hasOwnProperty.call(input,'contact') || Object.prototype.hasOwnProperty.call(input,'shipping') || Object.prototype.hasOwnProperty.call(input,'delivery') || Object.prototype.hasOwnProperty.call(input,'meta')){
          rawDetails = parseFulfillmentDetails(input.raw ?? input);
        }
      }
      if(!rawDetails){ rawDetails = parseFulfillmentDetails(input); }
      const source = (value, fallback)=>{
        if(value === undefined || value === null) return fallback;
        return value;
      };
      const raw = rawDetails && typeof rawDetails === 'object' ? rawDetails : {};
      const contactSource = (input && typeof input === 'object' && input.contact && typeof input.contact === 'object') ? input.contact : {};
      const shippingSource = (input && typeof input === 'object' && input.shipping && typeof input.shipping === 'object') ? input.shipping : {};
      const deliverySource = (input && typeof input === 'object' && input.delivery && typeof input.delivery === 'object') ? input.delivery : {};
      const metaSource = (input && typeof input === 'object' && input.meta && typeof input.meta === 'object') ? input.meta : {};
      const contact = {
        name: (source(contactSource.name, raw.contact_name)||'').toString().trim(),
        email: (source(contactSource.email, raw.contact_email)||'').toString().trim(),
        phone: (source(contactSource.phone, raw.contact_phone)||'').toString().trim(),
        consent: boolish(source(contactSource.consent, source(contactSource.consent_contact, source(raw.consent_contact, raw.consent_whatsapp))))
      };
      const shipping = {
        address_line1: (source(shippingSource.address_line1, raw.address_line1)||'').toString().trim(),
        address_line2: (source(shippingSource.address_line2, raw.address_line2)||'').toString().trim(),
        postal_code: (source(shippingSource.postal_code, raw.postal_code)||'').toString().trim(),
        city: (source(shippingSource.city, raw.city)||'').toString().trim(),
        address_extra: (source(shippingSource.address_extra, raw.address_extra)||'').toString().trim(),
      };
      const delivery = {
        meeting_point: (source(deliverySource.meeting_point, raw.meeting_point)||'').toString().trim(),
        preferred_time: (source(deliverySource.preferred_time, raw.preferred_time)||'').toString().trim(),
      };
      const meta = {
        submitted_at: (source(metaSource.submitted_at, raw.submitted_at)||'').toString().trim(),
        submitted_via: (source(metaSource.submitted_via, raw.submitted_via)||'').toString().trim(),
        booking_display_id: (source(metaSource.booking_display_id, raw.booking_display_id)||'').toString().trim(),
      };
      const requiresDetails = ['shipping','delivery'].includes(normalizedMethod);
      const missing = [];
      if(requiresDetails){
        if(!contact.name) missing.push('Kontakt (Name)');
        if(!contact.phone) missing.push('Kontakt (Telefon)');
        if(!contact.email) missing.push('Kontakt (E-Mail)');
        if(normalizedMethod === 'shipping'){
          if(!shipping.address_line1) missing.push('Lieferadresse (Straße)');
          if(!shipping.postal_code || !shipping.city) missing.push('Lieferadresse (PLZ/Ort)');
        }else if(normalizedMethod === 'delivery'){
          if(!delivery.meeting_point) missing.push('Treffpunkt');
          if(!delivery.preferred_time) missing.push('Wunschzeit');
        }
      }
      const providedMissing = Array.isArray(input?.missing) ? input.missing.map(x=>x&&x.toString().trim()).filter(Boolean) : [];
      const mergedMissing = Array.from(new Set([...missing, ...providedMissing]));
      const needsAttention = typeof input?.needs_attention === 'boolean'
        ? Boolean(input.needs_attention)
        : (requiresDetails && mergedMissing.length>0);
      return {
        raw,
        contact,
        shipping,
        delivery,
        meta,
        missing: mergedMissing,
        requires_details: requiresDetails,
        needs_attention: needsAttention,
      };
    };

    const normalizeFulfillmentPayload = (payload, fallbackMethod, structured)=>{
      if(!payload || typeof payload !== 'object') return null;
      const rawMethod = (payload.method ?? payload.id ?? fallbackMethod ?? '').toString().trim().toLowerCase();
      const method = ['pickup','shipping','delivery'].includes(rawMethod) ? rawMethod : (fallbackMethod || 'pickup');
      const infoLines = Array.isArray(payload.info_lines ?? payload.infoLines)
        ? (payload.info_lines ?? payload.infoLines).map(x=>String(x))
        : [];
      const displayLabel = (payload.display_label ?? payload.displayLabel ?? '').toString().trim();
      const missing = Array.isArray(payload.missing_details ?? payload.missingDetails)
        ? (payload.missing_details ?? payload.missingDetails).map(x=>String(x).trim()).filter(Boolean)
        : [];
      const requiresDetails = typeof payload.requires_details === 'boolean'
        ? Boolean(payload.requires_details)
        : typeof payload.requiresDetails === 'boolean'
          ? Boolean(payload.requiresDetails)
          : ['shipping','delivery'].includes(method);
      const detailsStructured = payload.details && typeof payload.details === 'object'
        ? buildFulfillmentDetails(payload.details, method)
        : structured;
      const baseMissing = missing.length ? missing : (detailsStructured?.missing || []);
      const needsAttention = typeof payload.needs_attention === 'boolean'
        ? Boolean(payload.needs_attention)
        : typeof payload.needsAttention === 'boolean'
          ? Boolean(payload.needsAttention)
          : (requiresDetails && baseMissing.length>0);
      return {
        id: method,
        method,
        label: (payload.label ?? '').toString(),
        full: (payload.full ?? '').toString(),
        note: (payload.note ?? '').toString(),
        priceDelta: Number(payload.price_delta ?? payload.priceDelta ?? 0),
        displaySuffix: (payload.display_suffix ?? payload.displaySuffix ?? '').toString(),
        infoLines,
        displayLabel,
        requiresDetails,
        missingDetails: baseMissing,
        needsAttention,
        details_structured: detailsStructured,
      };
    };

    const fulfillmentInstructionLines = (info, detailsOverride)=>{
      const base = Array.isArray(info.infoLines) ? info.infoLines.map(x=>String(x).trim()).filter(Boolean) : [];
      const lines = base.slice();
      const structured = info.details_structured
        ? info.details_structured
        : buildFulfillmentDetails(detailsOverride ?? info.details ?? {}, info.id || info.method);
      const contact = structured.contact || {};
      const shipping = structured.shipping || {};
      const delivery = structured.delivery || {};
      const contactParts = [];
      if(contact.name) contactParts.push(contact.name);
      if(contact.phone) contactParts.push(`Tel: ${contact.phone}`);
      if(contact.email) contactParts.push(`E-Mail: ${contact.email}`);
      const hasContact = contactParts.length>0;
      if(hasContact){ lines.push(`👤 Kontakt: ${contactParts.join(' | ')}`); }

      if(contact.consent === true){ lines.push('✅ Kontakt per Telefon & WhatsApp ist freigegeben.'); }
      else if(contact.consent === false){ lines.push('⚠️ Bitte nur per E-Mail kontaktieren (kein Telefon/WhatsApp).'); }

      if((info.id||info.method) === 'shipping'){
        const parts = [];
        if(shipping.address_line1) parts.push(shipping.address_line1);
        if(shipping.address_line2) parts.push(shipping.address_line2);
        const cityPart = [shipping.postal_code, shipping.city].filter(Boolean).join(' ').trim();
        if(cityPart) parts.push(cityPart);
        if(shipping.address_extra) parts.push(shipping.address_extra);
        if(parts.length) lines.push(`🏠 Lieferadresse: ${parts.join(', ')}`);
      }

      if((info.id||info.method) === 'delivery'){
        if(delivery.meeting_point) lines.push(`📍 Treffpunkt: ${delivery.meeting_point}`);
        if(delivery.preferred_time) lines.push(`🕒 Wunschzeit (Mittag): ${delivery.preferred_time}`);
      }

      if(structured.requires_details){
        if(!hasContact) lines.push('⚠️ Kein Kontakt für diese Abwicklung hinterlegt – bitte ergänzen.');
        if((info.id||info.method)==='shipping' && (!shipping.address_line1 || !shipping.postal_code || !shipping.city)){
          lines.push('⚠️ Es liegt noch keine vollständige Lieferadresse vor.');
        }
        if((info.id||info.method)==='delivery' && (!delivery.meeting_point || !delivery.preferred_time)){
          lines.push('⚠️ Treffpunkt oder Wunschzeit fehlen bislang.');
        }
        if(Array.isArray(structured.missing) && structured.missing.length){
          lines.push(`❗ Fehlende Angaben: ${structured.missing.join(', ')}`);
        }
      }

      return lines;
    };

    // Anzeige-ID (nur Ziffern), Prefix 00 + laufend ab 100
    const ID_CATEGORY = '00';
    function computeDisplayId(rawId){
      const numeric = Number(rawId);
      if (Number.isFinite(numeric) && numeric > 0) {
        const base = Math.trunc(100 + numeric);
        return ID_CATEGORY + String(base).padStart(3,'0');
      }
      const digits = String(rawId ?? '').replace(/[^0-9]/g,'');
      if (digits) {
        const tail = digits.slice(-3);
        return ID_CATEGORY + tail.padStart(3,'0');
      }
      return ID_CATEGORY + '000';
    }
    function normalizeDisplayId(rawId, provided){
      const direct = (typeof provided === 'string') ? provided.trim() : '';
      if (direct) return direct;
      return computeDisplayId(rawId);
    }
    function displayId(value){
      if (value && typeof value === 'object') {
        return normalizeDisplayId(value.id ?? value.booking_id ?? null, value.display_id ?? value.displayId ?? null);
      }
      return normalizeDisplayId(value, null);
    }

