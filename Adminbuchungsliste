        const phoneHtml = booking.customer_phone ? this.escape(booking.customer_phone) : '<span class="mmb-text-muted">Keine Angabe</span>';
        const noteHtml = booking.note
          ? this.escape(booking.note).replace(/\n/g,'<br>')
          : '<span class="mmb-text-muted">Keine Anmerkungen</span>';
