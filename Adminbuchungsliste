<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MietMichBox – Admin Buchungsliste</title>
  <style>
    :root {
      --admin-bg: #f5f5f5;
      --admin-card-bg: #ffffff;
      --admin-border: #e5e7eb;
      --admin-text: #111827;
      --admin-muted: #6b7280;
      --admin-accent: #0ea5e9;
      --admin-error: #dc2626;
      --admin-success: #16a34a;
      --admin-warning: #f59e0b;
      --admin-radius: 14px;
      --admin-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
    }

    body {
      margin: 0;
      padding: 0;
      background: var(--admin-bg);
      font-family: 'Poppins', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: var(--admin-text);
    }

    .card {
      max-width: 1100px;
      min-height: 640px;
      margin: 40px auto;
      background: var(--admin-card-bg);
      border-radius: var(--admin-radius);
      box-shadow: var(--admin-shadow);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .card h1 {
      margin: 0;
      padding: 28px 32px;
      border-bottom: 1px solid var(--admin-border);
      font-size: 1.6rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .card .content {
      flex: 1;
      padding: 28px 32px 36px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .admin-shell {
      position: relative;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .admin-shell__login,
    .admin-shell__content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .admin-shell__content {
      display: none;
    }

    .admin-shell--authenticated .admin-shell__login {
      display: none;
    }

    .admin-shell--authenticated .admin-shell__content {
      display: flex;
    }

    .admin-login-form {
      margin: auto;
      max-width: 360px;
      width: 100%;
      padding: 32px 28px;
      border: 1px solid var(--admin-border);
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 14px 28px rgba(15, 23, 42, 0.08);
      display: flex;
      flex-direction: column;
      gap: 18px;
      text-align: center;
    }

    .admin-login-form__heading h2 {
      margin: 0 0 8px 0;
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--admin-text);
    }

    .admin-login-form__heading p {
      margin: 0;
      font-size: 0.95rem;
      color: var(--admin-muted);
    }

    .admin-login-form__field {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      text-align: left;
      font-size: 0.95rem;
      color: var(--admin-text);
    }

    .admin-login-form__field input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid var(--admin-border);
      font-size: 1rem;
      font-family: inherit;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .admin-login-form__field input:focus {
      outline: none;
      border-color: var(--admin-accent);
      box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.18);
    }

    .admin-login-form button {
      border: none;
      border-radius: 999px;
      background: var(--admin-accent);
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
      padding: 12px 0;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .admin-login-form button:hover:not(:disabled) {
      background: #0284c7;
      transform: translateY(-1px);
    }

    .admin-login-form button:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    .admin-login-form__message {
      min-height: 1.2rem;
      font-size: 0.9rem;
      color: var(--admin-muted);
    }

    .admin-login-form__message.is-error {
      color: var(--admin-error);
    }

    .admin-login-form__message.is-success {
      color: var(--admin-success);
    }

    .admin-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
    }

    .admin-toolbar__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .admin-btn {
      background: #fff;
      border: 1px solid var(--admin-border);
      border-radius: 999px;
      padding: 10px 18px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      color: var(--admin-text);
      transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    }

    .admin-btn:hover {
      background: var(--admin-accent);
      color: #fff;
      box-shadow: 0 12px 24px rgba(14, 165, 233, 0.18);
    }

    .admin-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      color: var(--admin-muted);
      font-size: 0.9rem;
    }

    .admin-meta__item {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .admin-meta__item strong {
      color: var(--admin-text);
      font-weight: 600;
    }

    .admin-status {
      font-size: 0.95rem;
      padding: 12px 16px;
      border-radius: 10px;
      background: #f8fafc;
      color: var(--admin-muted);
      border: 1px solid rgba(15, 23, 42, 0.05);
    }

    .admin-status.is-error {
      color: var(--admin-error);
      background: rgba(220, 38, 38, 0.08);
      border-color: rgba(220, 38, 38, 0.12);
    }

    .admin-status.is-success {
      color: var(--admin-success);
      background: rgba(22, 163, 74, 0.08);
      border-color: rgba(22, 163, 74, 0.12);
    }

    .admin-table-wrapper {
      flex: 1;
      min-height: 320px;
      overflow: hidden;
      border-radius: 16px;
      border: 1px solid var(--admin-border);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.92rem;
    }

    thead {
      background: #f8fafc;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--admin-muted);
    }

    th, td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--admin-border);
      vertical-align: top;
      text-align: left;
    }

    tbody tr:hover {
      background: rgba(14, 165, 233, 0.06);
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 4px 10px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: capitalize;
    }

    .status-badge--pending {
      background: rgba(245, 158, 11, 0.16);
      color: #92400e;
    }

    .status-badge--confirmed {
      background: rgba(220, 38, 38, 0.18);
      color: #991b1b;
    }

    .status-badge--cancelled,
    .status-badge--rejected {
      background: rgba(75, 85, 99, 0.18);
      color: #1f2937;
    }

    .muted {
      color: var(--admin-muted);
    }

    .text-ellipsis {
      max-width: 220px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    @media (max-width: 960px) {
      .card {
        margin: 24px auto;
        border-radius: 18px;
      }

      .card h1 {
        padding: 24px;
      }

      .card .content {
        padding: 24px;
      }

      th, td {
        padding: 10px 12px;
      }

      .text-ellipsis {
        max-width: 160px;
      }
    }

    @media (max-width: 720px) {
      .card {
        margin: 16px;
        border-radius: 18px;
      }

      .card .content {
        padding: 20px;
      }

      .admin-meta {
        flex-direction: column;
        gap: 8px;
      }

      .admin-toolbar {
        flex-direction: column;
        align-items: stretch;
      }

      .admin-toolbar__actions {
        justify-content: flex-start;
      }

      table {
        font-size: 0.85rem;
      }

      .text-ellipsis {
        max-width: 120px;
      }
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Admin – Buchungsliste</h1>
    <div class="content">
      <div id="admin-app" class="admin-app"></div>
    </div>
  </div>

  <script src="admin_portal.js" data-api-base="./"></script>
  <script>
  (function () {
    const portal = window.MMBAdminPortal;
    const host = document.getElementById('admin-app');
    if (!portal || !host) {
      return;
    }

    const state = {
      lastLoadedAt: null,
      loading: false,
    };

    portal.mount(host, {
      loginTitle: 'Admin-Zugang',
      loginDescription: 'Bitte gib das Passwort ein, um die Buchungsübersicht zu sehen.',
      renderApp: async function renderApp(container) {
        container.innerHTML = '';

        const toolbar = document.createElement('div');
        toolbar.className = 'admin-toolbar';

        const actions = document.createElement('div');
        actions.className = 'admin-toolbar__actions';
        const refreshBtn = document.createElement('button');
        refreshBtn.className = 'admin-btn';
        refreshBtn.type = 'button';
        refreshBtn.textContent = 'Aktualisieren';
        actions.appendChild(refreshBtn);

        const meta = document.createElement('div');
        meta.className = 'admin-meta';
        meta.innerHTML = `
          <span class="admin-meta__item"><strong data-meta="count">–</strong> Buchungen</span>
          <span class="admin-meta__item">⏱️ <span data-meta="updated">–</span></span>
          <span class="admin-meta__item">⚠️ Details offen: <strong data-meta="needs">0</strong></span>
        `;

        toolbar.appendChild(actions);
        toolbar.appendChild(meta);

        const status = document.createElement('div');
        status.className = 'admin-status';
        status.textContent = 'Bereit.';

        const tableWrapper = document.createElement('div');
        tableWrapper.className = 'admin-table-wrapper';
        tableWrapper.innerHTML = `
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Box</th>
                <th>Kunde</th>
                <th>E-Mail</th>
                <th>Zeitraum</th>
                <th>Status</th>
                <th>Gesamt (€)</th>
                <th>Erstellt</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        `;
        const tbody = tableWrapper.querySelector('tbody');

        container.appendChild(toolbar);
        container.appendChild(status);
        container.appendChild(tableWrapper);

        refreshBtn.addEventListener('click', () => {
          loadData();
        });

        async function loadData() {
          if (state.loading) {
            return;
          }
          state.loading = true;
          status.className = 'admin-status';
          status.textContent = 'Lade Buchungen …';
          tbody.innerHTML = '';

          try {
            const data = await portal.request('list_bookings.php');
            if (!data || data.ok === false) {
              throw new Error(data && data.error ? data.error : 'Buchungen konnten nicht geladen werden.');
            }

            const items = Array.isArray(data.items) ? data.items : [];
            renderRows(items);
            updateMeta(data.meta || {}, items.length);

            state.lastLoadedAt = new Date();
            status.className = 'admin-status is-success';
            status.textContent = `Zuletzt aktualisiert: ${formatTimestamp(state.lastLoadedAt)}`;
          } catch (error) {
            if (error && error.code === 'UNAUTHORIZED') {
              return;
            }
            status.className = 'admin-status is-error';
            status.textContent = error && error.message ? String(error.message) : 'Unbekannter Fehler beim Laden der Buchungen.';
            tbody.innerHTML = '<tr><td colspan="8" class="muted">Keine Daten verfügbar.</td></tr>';
          } finally {
            state.loading = false;
          }
        }

        function renderRows(items) {
          if (!items.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="muted">Keine Buchungen vorhanden.</td></tr>';
            return;
          }

          const rows = items.map((item) => {
            const displayId = escapeHtml(item.display_id || item.id || '–');
            const boxName = escapeHtml(item.box_name || (item.box_id ? `Box #${item.box_id}` : '–'));
            const customer = escapeHtml(item.customer_name || '–');
            const email = escapeHtml(item.customer_email || '–');
            const period = `${formatDate(item.start_date)} – ${formatDate(item.end_date)}`;
            const statusBadge = createStatusBadge(item.status);
            const total = formatCurrency(item.total_amount);
            const created = formatTimestamp(item.created_at);

            return `
              <tr>
                <td>${displayId}</td>
                <td class="text-ellipsis" title="${boxName}">${boxName}</td>
                <td class="text-ellipsis" title="${customer}">${customer}</td>
                <td class="text-ellipsis" title="${email}">${email}</td>
                <td>${escapeHtml(period)}</td>
                <td>${statusBadge}</td>
                <td>${escapeHtml(total)}</td>
                <td>${escapeHtml(created)}</td>
              </tr>
            `;
          });

          tbody.innerHTML = rows.join('');
        }

        function updateMeta(metaData, rowCount) {
          const countEl = meta.querySelector('[data-meta="count"]');
          const needsEl = meta.querySelector('[data-meta="needs"]');
          const updatedEl = meta.querySelector('[data-meta="updated"]');

          if (countEl) {
            countEl.textContent = String(rowCount ?? metaData.count ?? 0);
          }
          if (needsEl) {
            needsEl.textContent = String(metaData.requires_details ?? 0);
          }
          if (updatedEl) {
            updatedEl.textContent = state.lastLoadedAt ? formatTimestamp(state.lastLoadedAt) : '–';
          }
        }

        function escapeHtml(value) {
          if (value === null || value === undefined) {
            return '';
          }
          return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        }

        function formatDate(value) {
          if (!value) {
            return '–';
          }
          const date = new Date(value);
          if (Number.isNaN(date.getTime())) {
            return String(value);
          }
          return date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
        }

        function formatTimestamp(value) {
          if (!value) {
            return '–';
          }
          const date = new Date(value);
          if (Number.isNaN(date.getTime())) {
            return String(value);
          }
          return date.toLocaleString('de-DE', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });
        }

        function formatCurrency(value) {
          const number = Number(value);
          if (Number.isFinite(number)) {
            return number.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
          }
          return value !== undefined && value !== null ? String(value) : '–';
        }

        function createStatusBadge(status) {
          const normalized = String(status || '').toLowerCase();
          const label = normalized ? normalized.charAt(0).toUpperCase() + normalized.slice(1) : '–';
          let cls = 'status-badge';
          if (normalized === 'pending') {
            cls += ' status-badge--pending';
          } else if (normalized === 'confirmed') {
            cls += ' status-badge--confirmed';
          } else if (normalized === 'cancelled' || normalized === 'rejected') {
            cls += ' status-badge--cancelled';
          }
          return `<span class="${cls}">${escapeHtml(label)}</span>`;
        }

        loadData();
      },
    });
  })();
  </script>
</body>
</html>
