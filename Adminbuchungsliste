  <script src="admin_auth.js" data-api-base="./"></script>
  <script>
  (function(global){'use strict';

    const AdminApi = (()=>{
      const candidate = (global && typeof global.AdminApi === 'object') ? global.AdminApi : null;
      if(candidate && typeof candidate.listBookings === 'function'){
        return candidate;
      }
      const fallback = (global && typeof global.MMBApi === 'object') ? global.MMBApi : null;
      if(fallback && typeof fallback.listBookings === 'function'){
        try{ global.AdminApi = fallback; }catch(_){ /* ignore */ }
        return fallback;
      }
      return {
        listBookings(){ return Promise.reject(new Error('Admin API ist nicht verfügbar.')); },
        updateBooking(){ return Promise.reject(new Error('Admin API ist nicht verfügbar.')); },
        updateBookingStatus(){ return Promise.reject(new Error('Admin API ist nicht verfügbar.')); },
        deleteBooking(){ return Promise.reject(new Error('Admin API ist nicht verfügbar.')); },
      };
    })();

    function injectBaseCSS(){
      if (document.getElementById('mmb-core-css')) return;
      const style=document.createElement('style'); style.id='mmb-core-css';
      style.textContent=`
        :root{
          --mmb-primary:#3b3b3b; --mmb-accent:#0EA5E9; --mmb-bg:#efefe6;
          --mmb-muted:#f8f9fa; --mmb-ok:#10b981; --mmb-warn:#f59e0b;
          --mmb-busy:#ef4444; --mmb-border:#e5e7eb; --mmb-text:#3b3b3b; --mmb-text-light:#6b7280;
        }
        @media (prefers-color-scheme: dark){
          :root{ --mmb-bg:#3b3b3b; --mmb-muted:#4a4a4a; --mmb-border:#555; --mmb-text:#fff; --mmb-text-light:#ccc; --mmb-primary:#fff; }
        }
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap');

        .mmb-widget{font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;background:var(--mmb-bg);color:var(--mmb-text);border-radius:8px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.1);}
        .mmb-loading{display:flex;justify-content:center;align-items:center;height:200px;font-size:.875rem;color:var(--mmb-text-light);}
        @media (prefers-reduced-motion: reduce){.mmb-day,.mmb-btn,.mmb-nav-btn{transition:none;}}
      `;
      document.head.appendChild(style);
    }

    class EventEmitter{constructor(){this.events={};} on(e,l){(this.events[e]??=[]).push(l);} off(e,l){if(!this.events[e])return; this.events[e]=this.events[e].filter(x=>x!==l);} emit(e,d){(this.events[e]||[]).forEach(l=>l(d));}}

    class GlobalState{
      constructor(){ this.instances=new Map(); this.sharedState={availability:{}, bookings:[], customerBookings:new Map()};}
      registerInstance(id,inst){this.instances.set(id,inst);} unregisterInstance(id){this.instances.delete(id);}
      updateAvailability(boxId,dateString,availability,source='admin'){
        const key=`${boxId}_${dateString}`; this.sharedState.availability[key]=availability;
        if(source==='customer'&&availability.available===0){ this.sharedState.customerBookings.set(key,true); }
        else if(source==='admin'&&availability.available>0){ this.sharedState.customerBookings.delete(key); }
        MMBCore.events.emit('availability:changed',{boxId,dateString,availability,source});
      }
      getAvailability(boxId,dateString){ return this.sharedState.availability[`${boxId}_${dateString}`]; }
      isCustomerBooked(boxId,dateString){ return this.sharedState.customerBookings.has(`${boxId}_${dateString}`); }
    }

    const Utils={
      MONTH_NAMES:['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'],
      DAY_NAMES:['Mo','Di','Mi','Do','Fr','Sa','So'],
      formatDate(d){const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),da=String(d.getDate()).padStart(2,'0'); return `${y}-${m}-${da}`;},
      formatMonthYear(d){return `${this.MONTH_NAMES[d.getMonth()]} ${d.getFullYear()}`;},
      formatDateRange(s,e){return `${s.toLocaleDateString('de-DE')} - ${e.toLocaleDateString('de-DE')}`;},
      generateCalendarDays(cur){const y=cur.getFullYear(),m=cur.getMonth(),first=new Date(y,m,1),last=new Date(y,m+1,0); const start=(first.getDay()===0?6:first.getDay()-1); const days=[]; const prevLast=new Date(y,m,0);
        for(let i=start-1;i>=0;i--){days.push({date:new Date(y,m-1,prevLast.getDate()-i),otherMonth:true});}
        for(let d=1; d<=last.getDate(); d++){days.push({date:new Date(y,m,d),otherMonth:false});}
        const total=Math.ceil(days.length/7)*7; for(let d=1; d<=total-days.length; d++){days.push({date:new Date(y,m+1,d),otherMonth:true});}
        return days;},
      escapeHtml(value){ if(value===null||value===undefined) return ''; return String(value).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])); },
      describeError(error, options={}){
        const headline=(typeof options.headline==='string'&&options.headline.trim())?options.headline.trim():'Unbekannter Fehler';
        const fallback=(typeof options.fallbackMessage==='string'&&options.fallbackMessage.trim())?options.fallbackMessage.trim():'Bitte prüfen Sie die Browser-Konsole für weitere Details.';
        const info={headline,message:fallback,status:null,context:typeof options.context==='string'?options.context:'',items:[],raw:null};
        const pushDetail=(value)=>{
          if(value===null||value===undefined) return;
          if(typeof value==='string'){const trimmed=value.trim(); if(trimmed) info.items.push(trimmed); return;}
          if(typeof value==='number'||typeof value==='boolean'){info.items.push(String(value)); return;}
          if(Array.isArray(value)){value.forEach(pushDetail); return;}
          try{const json=JSON.stringify(value,null,2); if(json) info.items.push(json);}catch(_){info.items.push(String(value));}
        };
        if(error instanceof Error){
          if(typeof error.message==='string'&&error.message.trim()) info.message=error.message.trim();
          if(typeof error.status==='number'&&!Number.isNaN(error.status)) info.status=error.status;
          if(error.name&&error.name!=='Error') pushDetail(`Fehlertyp: ${error.name}`);
          if('details' in error) pushDetail(error.details);
          if('detail' in error) pushDetail(error.detail);
          if('error' in error&&error.error!==error.message) pushDetail(error.error);
          if(!info.context&&error.context){
            if(typeof error.context==='string') info.context=error.context;
            else if(error.context&&typeof error.context.path==='string') info.context=error.context.path;
          }
          if(typeof error.raw==='string'&&error.raw.trim()) info.raw=error.raw.slice(0,1200);
        }else if(error&&typeof error==='object'){
          if(typeof error.message==='string'&&error.message.trim()) info.message=error.message.trim();
          if(typeof error.status==='number'&&!Number.isNaN(error.status)) info.status=error.status;
          if(typeof error.context==='string') info.context=error.context;
          pushDetail(error.details??error.detail??error.error??error);
        }else if(typeof error==='string'&&error.trim()){
          info.message=error.trim();
        }
        if(!info.context&&typeof options.context==='string') info.context=options.context;
        if(typeof options.status==='number'&&!info.status) info.status=options.status;
        if(options.extra) pushDetail(options.extra);
        return info;
      },
      showNotification(msg,type='info'){const ex=document.querySelector(`.mmb-${type}-notification`); if(ex) ex.remove(); const el=document.createElement('div'); el.className=`mmb-${type}-notification`; const bg=type==='error'?'var(--mmb-busy)':'var(--mmb-ok)';
        el.style.cssText=`position:fixed;top:20px;right:20px;background:${bg};color:#fff;padding:1rem;border-radius:4px;box-shadow:0 4px 6px rgba(0,0,0,.1);z-index:1000;max-width:300px;`; el.textContent=msg; document.body.appendChild(el); setTimeout(()=>el.remove(),5000);}
    };

    injectBaseCSS(); const events=new EventEmitter(), globalState=new GlobalState();
    global.MMBCore={events,globalState,Utils,version:'1.0.0'};
  })(window);
  </script>

  <!-- ======================= MMB API ======================= -->
  <script>
  (function(global){'use strict';

    var MMBAdminAuth = (function(){
      if (typeof window !== 'undefined' && window.MMBAdminAuth) {
        return window.MMBAdminAuth;
      }
      const fallbackState = {
        getApiBase: () => './',
        getSessionState: () => ({ authDisabled: true, bootstrapSkipped: true }),
        isAuthDisabled: () => true,
        shouldSendCredentials: () => false,
        enterPublicMode: () => {},
        exitPublicMode: () => {},
      };
      if (typeof window !== 'undefined') {
        try {
          window.MMBAdminAuth = fallbackState;
        } catch (_) {
          try {
            Object.defineProperty(window, 'MMBAdminAuth', { value: fallbackState });
          } catch (__) {
            /* ignore */
          }
        }
      }
      return fallbackState;
    })();

    function mmbResolveApiBase(){
      let base = './';
      try {
        if (MMBAdminAuth && typeof MMBAdminAuth.getApiBase === 'function') {
          base = MMBAdminAuth.getApiBase();
        }
      } catch (_) {
        base = './';
      }
      if (base && typeof base === 'object' && typeof base.href === 'string') {
        base = base.href;
      }
      base = (base || './').toString();
      if (!base.endsWith('/')) {
        base += base.indexOf('?') === -1 ? '/' : '';
      }
      return base;
    }

    const rawApiBase = mmbResolveApiBase();
    let resolvedBaseUrl;
    try {
      resolvedBaseUrl = new URL(rawApiBase || './', global.location?.href || global.document?.baseURI || 'https://example.com/');
    } catch (_) {
      resolvedBaseUrl = new URL('./', global.location?.href || global.document?.baseURI || 'https://example.com/');
    }
    if (!resolvedBaseUrl.pathname.endsWith('/')) {
      resolvedBaseUrl = new URL('./', resolvedBaseUrl);
    }
    const MMB_API_BASE = resolvedBaseUrl.href;
    function buildApiUrl(path){
      try{
        return new URL(path, MMB_API_BASE).href;
      }catch(_){
        return MMB_API_BASE + path;
      }
    }
    let preferPublicRequests = false;

    function refreshPreferredCredentials(){
      if (typeof MMBAdminAuth?.getSessionState === 'function') {
        const state = MMBAdminAuth.getSessionState();
        if (state && (state.authDisabled || state.bootstrapSkipped)) {
          preferPublicRequests = true;
        }
      } else if (typeof MMBAdminAuth?.isAuthDisabled === 'function') {
        if (MMBAdminAuth.isAuthDisabled()) {
          preferPublicRequests = true;
        }
      }
    }

    function shouldRetryWithoutCredentials(error){
      if (!error) return true;
      if (error.name === 'TypeError') return true;
      const status = typeof error.status === 'number' ? error.status : null;
      if (status === 0 || status === 401 || status === 403) return true;
      const message = typeof error.message === 'string' ? error.message : '';
      return /fetch|network|cors|unauthorized|credentials|cookie|json/i.test(message);
    }

    function shouldRetryWithCredentials(error){
      if (!error) return true;
      if (error.name === 'TypeError') return true;
      const status = typeof error.status === 'number' ? error.status : null;
      if (status === 401 || status === 403) return true;
      const message = typeof error.message === 'string' ? error.message : '';
      return /unauthorized|anmeldung|login|session|json/i.test(message);
    }

    async function requestJson(path,{method='GET',body=null}={},credentialsMode='include'){
      const normalizedMethod=typeof method==='string'?method.toUpperCase():'GET';
      const targetUrl=buildApiUrl(path);
      const context={ path, url: targetUrl, method: normalizedMethod, credentialsMode };
      const fetchOptions={
        method: normalizedMethod,
        credentials:credentialsMode,
        headers:{},
      };
      if(normalizedMethod==='POST'){
        fetchOptions.headers['Content-Type']='application/json';
        fetchOptions.body=JSON.stringify(body||{});
      }
      let res;
      try{
        res=await fetch(targetUrl,fetchOptions);
      }catch(networkError){
        const err = networkError instanceof Error ? networkError : new Error(String(networkError));
        if(typeof err.status!=='number') err.status=0;
        err.credentialsMode=credentialsMode;
        err.context = Object.assign({}, err.context||{}, context);
        throw err;
      }
      const text=await res.text();
      let data;
      try{
        data=text?JSON.parse(text):{};
      }catch(parseError){
        const err=new Error('Server lieferte keine gültige JSON-Antwort');
        err.raw=text;
        err.status=res.status;
        err.credentialsMode=credentialsMode;
        err.cause=parseError;
        err.context=context;
        throw err;
      }

      const payload=(data&&typeof data==='object')?data:{};
      const okFlag=Object.prototype.hasOwnProperty.call(payload,'ok')?Boolean(payload.ok):true;
      if(!res.ok||!okFlag){
        const message=(payload.error||payload.message||`HTTP ${res.status}`);
        const error=new Error(message);
        error.details=payload;
        error.status=res.status;
        error.credentialsMode=credentialsMode;
        error.context=context;
        throw error;
      }

      return payload;
    }

    async function mmbApiGet(path){
      refreshPreferredCredentials();
      const order = preferPublicRequests ? ['omit','include'] : ['include','omit'];
      let lastError=null;
      let attemptedOmit=false;
      for(const mode of order){
        if(mode==='omit') attemptedOmit=true;
        try{
          const result=await requestJson(path,{method:'GET'},mode);
          if(mode==='omit'){
            preferPublicRequests=true;
          }else if(mode==='include'&&attemptedOmit){
            preferPublicRequests=false;
          }
          return result;
        }catch(error){
          if(error && typeof error==='object'){
            error.retryMode = mode;
            if(!error.context){ error.context = { path, method:'GET', credentialsMode: mode==='include'?'include':'omit' }; }
          }
          lastError=error;
          if(mode==='include'){
            if(!preferPublicRequests && shouldRetryWithoutCredentials(error)){
              continue;
            }
          }else if(mode==='omit'){
            if(preferPublicRequests && shouldRetryWithCredentials(error)){
              continue;
            }
          }
          throw error;
        }
      }
      if(lastError){
        if(lastError && typeof lastError==='object' && !lastError.context){
          lastError.context = { path, method:'GET' };
        }
        throw lastError;
      }
      const fallbackError=new Error('Unbekannter API-Fehler');
      fallbackError.context={ path, method:'GET' };
      throw fallbackError;
    }

    async function mmbApiPost(path,body){
      refreshPreferredCredentials();
      const order = preferPublicRequests ? ['omit','include'] : ['include','omit'];
      let lastError=null;
      let attemptedOmit=false;
      for(const mode of order){
        if(mode==='omit') attemptedOmit=true;
        try{
          const result=await requestJson(path,{method:'POST',body},mode);
          if(mode==='omit'){
            preferPublicRequests=true;
          }else if(mode==='include'&&attemptedOmit){
            preferPublicRequests=false;
          }
          return result;
        }catch(error){
          if(error && typeof error==='object'){
            error.retryMode = mode;
            if(!error.context){ error.context = { path, method:'POST', credentialsMode: mode==='include'?'include':'omit' }; }
          }
          lastError=error;
          if(mode==='include'){
            if(!preferPublicRequests && shouldRetryWithoutCredentials(error)){
              continue;
            }
          }else if(mode==='omit'){
            if(preferPublicRequests && shouldRetryWithCredentials(error)){
              continue;
            }
          }
          throw error;
        }
      }
      if(lastError){
        if(lastError && typeof lastError==='object' && !lastError.context){
          lastError.context = { path, method:'POST' };
        }
        throw lastError;
      }
      const fallbackError=new Error('Unbekannter API-Fehler');
      fallbackError.context={ path, method:'POST' };
      throw fallbackError;
    }

    var MMBApi={
      async listBookings(params = {}) {
        const q=new URLSearchParams();
        if(params.box_id) q.set('box_id', params.box_id);
        if(params.status) q.set('status', params.status);
        if(params.from) q.set('from', params.from);
        if(params.to) q.set('to', params.to);
        return mmbApiGet('list_bookings.php'+(q.toString()?`?${q}`:''));
      },
      async updateBooking(payload){
        return mmbApiPost('update_booking.php', payload);
      },
      // FIX: richtiger Endpoint + richtige Keys
      async updateBookingStatus(payload){
        return mmbApiPost('update_booking_status.php', payload);
      },
      async deleteBooking(input){
        const value = (input && typeof input === 'object') ? (input.booking_id ?? input.id) : input;
        const numericId = Number(value);
        if(!Number.isFinite(numericId) || numericId <= 0){
          throw new Error('Ungültige Buchungs-ID');
        }
        return mmbApiPost('delete_booking.php', { booking_id: numericId });
      },
    };
    global.MMBApi = MMBApi;

    function resolveAdminApi(){
      const globalApi = (global && typeof global.MMBApi === 'object') ? global.MMBApi : null;
      if(globalApi && typeof globalApi.listBookings === 'function'){
        return globalApi;
      }
      if(typeof MMBApi !== 'undefined' && MMBApi && typeof MMBApi.listBookings === 'function'){
        if(!globalApi){
          try{ global.MMBApi = MMBApi; }catch(_){ /* ignore */ }
        }
        return MMBApi;
      }
      const fallback = {
        listBookings(params = {}){
          const q=new URLSearchParams();
          if(params.box_id) q.set('box_id', params.box_id);
          if(params.status) q.set('status', params.status);
          if(params.from) q.set('from', params.from);
          if(params.to) q.set('to', params.to);
          return mmbApiGet('list_bookings.php'+(q.toString()?`?${q}`:''));
        },
        updateBooking(payload){
          return mmbApiPost('update_booking.php', payload||{});
        },
        updateBookingStatus(payload){
          return mmbApiPost('update_booking_status.php', payload||{});
        },
        deleteBooking(input){
          const value = (input && typeof input === 'object') ? (input.booking_id ?? input.id ?? input) : input;
          const numericId = Number(value);
          if(!Number.isFinite(numericId) || numericId <= 0){
            return Promise.reject(new Error('Ungültige Buchungs-ID'));
          }
          return mmbApiPost('delete_booking.php', { booking_id: numericId });
        },
      };
      try{ global.MMBApi = fallback; }catch(_){ /* ignore */ }
      return fallback;
    }
    const AdminApi = resolveAdminApi();
    try {
      global.AdminApi = AdminApi;
    } catch (_) {
      /* ignore */
    }
  })(typeof globalThis !== 'undefined' ? globalThis : (typeof window !== 'undefined' ? window : this));
  </script>

