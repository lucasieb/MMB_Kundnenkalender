        const html = `
          <div class="mmb-field"><strong>Kund*in</strong><div>${this.escape(booking.customer_name)}</div><div class="mmb-text-muted" style="font-size:.85rem;">${this.escape(booking.customer_email)}</div></div>
          <div class="mmb-field"><strong>Abwicklung</strong><div>${this.escape(infoDisplay)}</div>${fulfillmentNoteHtml}</div>
          <div class="mmb-field"><strong>Buchung erstellt</strong><div>${createdLabel}</div></div>
          <div class="mmb-field"><strong>Telefon</strong><div>${phoneHtml}</div></div>
          <div class="mmb-field"><strong>Anmerkungen</strong><div>${noteHtml}</div></div>
        `;
        await this.openModal({ title:`Buchungsdetails – ${displayId(b)}`, html, confirmText:'Schließen', cancelText:'' });
      }

      async showFulfillmentDetails(id){
        const booking = this.state.originalBookings.find(x=>String(x.id)===String(id));
        if(!booking) return;
        const info = this.getFulfillmentInfo(booking);
        const instructions = this.fulfillmentInstructionLines(booking);
        const instructionHtml = instructions.length
          ? `<ul>${instructions.map(line=>'<li>'+this.escape(line)+'</li>').join('')}</ul>`
          : '<p class="mmb-text-muted">Keine zusätzlichen Informationen hinterlegt.</p>';
        const noteHtml = info.note ? `<div class="mmb-text-muted" style="font-size:.85rem;margin-top:.25rem;">${this.escape(info.note)}</div>` : '';
        const structured = info.details_structured || buildFulfillmentDetails(info.details || {}, info.id);
        const contact = structured.contact || {};
        const shipping = structured.shipping || {};
        const delivery = structured.delivery || {};
        const meta = structured.meta || {};
        const missing = Array.isArray(structured.missing) ? structured.missing.filter(Boolean) : [];
        const consentLabel = contact.consent === true
          ? 'Ja, Telefon/WhatsApp erlaubt'
          : contact.consent === false
            ? 'Nein, bitte nur E-Mail'
            : 'Nicht angegeben';
        const contactEntries = [];
        if(contact.name) contactEntries.push(`<div><strong>Name:</strong> ${this.escape(contact.name)}</div>`);
        if(contact.phone) contactEntries.push(`<div><strong>Telefon:</strong> ${this.escape(contact.phone)}</div>`);
        if(contact.email) contactEntries.push(`<div><strong>E-Mail:</strong> ${this.escape(contact.email)}</div>`);
        contactEntries.push(`<div><strong>Kontaktfreigabe:</strong> ${this.escape(consentLabel)}</div>`);
        const contactHtml = contactEntries.join('') || '<div class="mmb-text-muted">Keine Angaben</div>';
        const shippingLines = [];
        if(shipping.address_line1) shippingLines.push(this.escape(shipping.address_line1));
        if(shipping.address_line2) shippingLines.push(this.escape(shipping.address_line2));
        const cityLine = [shipping.postal_code, shipping.city].filter(Boolean).join(' ').trim();
        if(cityLine) shippingLines.push(this.escape(cityLine));
        if(shipping.address_extra) shippingLines.push(this.escape(shipping.address_extra));
        const shippingHtml = shippingLines.length ? `<div>${shippingLines.join('<br>')}</div>` : '<div class="mmb-text-muted">Keine Angaben</div>';
        const deliveryLines = [];
        if(delivery.meeting_point) deliveryLines.push(`<div><strong>Treffpunkt:</strong> ${this.escape(delivery.meeting_point)}</div>`);
        if(delivery.preferred_time) deliveryLines.push(`<div><strong>Wunschzeit:</strong> ${this.escape(delivery.preferred_time)}</div>`);
        const deliveryHtml = deliveryLines.length ? deliveryLines.join('') : '<div class="mmb-text-muted">Keine Angaben</div>';
        let submittedLabel = '';
        if(meta.submitted_at){
          const submittedDate = new Date(meta.submitted_at);
          if(!Number.isNaN(submittedDate.getTime())){
            submittedLabel = submittedDate.toLocaleString('de-DE', { dateStyle:'long', timeStyle:'short' });
          } else {
            submittedLabel = meta.submitted_at;
          }
        }
        const metaParts = [];
        if(submittedLabel){ metaParts.push(`<div><strong>Eingereicht am:</strong> ${this.escape(submittedLabel)}</div>`); }
        if(meta.submitted_via){ metaParts.push(`<div><strong>Eingang via:</strong> ${this.escape(meta.submitted_via)}</div>`); }
        if(meta.booking_display_id){ metaParts.push(`<div><strong>Display-ID:</strong> ${this.escape(meta.booking_display_id)}</div>`); }
        const metaHtml = metaParts.length ? `<div class="mmb-field"><strong>Metadaten</strong>${metaParts.join('')}</div>` : '';
        const attentionHtml = info.needsAttention && missing.length
          ? `<div class="mmb-warning" style="margin-top:.5rem;">⚠️ Es fehlen noch: ${this.escape(missing.join(', '))}</div>`
          : '';
        const detailSections = [];
        detailSections.push(`<div class="mmb-field"><strong>Kontakt</strong>${contactHtml}</div>`);
        if(info.method === 'shipping'){
          detailSections.push(`<div class="mmb-field"><strong>Lieferadresse</strong>${shippingHtml}</div>`);
        }
        if(info.method === 'delivery'){
          detailSections.push(`<div class="mmb-field"><strong>Lieferdetails</strong>${deliveryHtml}</div>`);
        }
        const detailHtml = detailSections.join('');
        const display = info.displayLabel && info.displayLabel.trim() ? info.displayLabel : fulfillmentDisplayLabel(info);
        const html = `
          <div class="mmb-field"><strong>Abwicklung</strong><div>${this.escape(display)}</div>${noteHtml}</div>
          ${attentionHtml}
          <div class="mmb-field"><strong>Informationen</strong>${instructionHtml}</div>
          ${detailHtml}
          ${metaHtml}
        `;
        await this.openModal({ title:`Abwicklung – ${displayId(b)}`, html, confirmText:'Schließen', cancelText:'' });
      }

      tplConfirm(b){
        const range = `${new Date(b.start_date).toLocaleDateString('de-DE')} – ${new Date(b.end_date).toLocaleDateString('de-DE')}`;
        const instructions = this.fulfillmentInstructionText(b);
        return `Hallo ${b.customer_name},

hier sind hervorragende Neuigkeiten für dich 🎉
        Wir haben deine Buchung mit der Buchungs-ID: ${displayId(b)} bestätigt.

Deine Buchung im Überblick:
👤 Name: ${b.customer_name}
📧 E-Mail: ${b.customer_email}
🎵 Musikbox: ${b.box_name}
🕰️ Zeitraum: ${range}
🚚 Abwicklung: ${this.fulfillmentEmailLine(b)}
💶 Gesamtkosten: ${this.formatEuro(b.price_total)}

Informationen für deine gewählte Abwicklung:
${instructions}

Bitte überprüfe einmal, ob wir deine Buchung korrekt hinterlegt haben.

Falls du noch offene Fragen hast, kannst du uns jederzeit kontaktieren.

Viele Grüße
Dein MietMichBox Team
www.mietmichbox.de

E-Mail: info@mietmichbox.de
Telefon: 01742015500`;
      }

      tplReject(b){
        const range = `${new Date(b.start_date).toLocaleDateString('de-DE')} – ${new Date(b.end_date).toLocaleDateString('de-DE')}`;
        return `Hallo ${b.customer_name},

        vielen Dank für deine Buchung (${displayId(b)}) für den Zeitraum ${range}.
Leider können wir diese Buchung nicht annehmen, da zu deinem gewählten Zeitraum bereits alle unsere Musikboxen vermietet sind.

Du kannst gerne direkt in unserem <a href="https://www.mietmichbox.de/buchungskalender" target="_blank" rel="noopener">Buchungskalender</a> eine neue Buchung zu einem anderen Zeitraum anfragen oder uns als Antwort auf diese E-Mail alternative Zeiträume nennen, sodass wir gemeinsam eine Lösung finden können. Wir helfen dir gerne schnellstmöglich weiter.

Falls du noch offene Fragen hast, kannst du uns jederzeit kontaktieren.

Viele Grüße
Dein MietMichBox Team
www.mietmichbox.de

E-Mail: info@mietmichbox.de
Telefon: 01742015500`;
      }

      tplAlternative(b, alternatives){
        const range = `${new Date(b.start_date).toLocaleDateString('de-DE')} – ${new Date(b.end_date).toLocaleDateString('de-DE')}`;
        const names = Array.isArray(alternatives)
          ? alternatives.map(x=>x?.name).filter(Boolean)
          : (alternatives && alternatives.name ? [alternatives.name] : []);
        let altSentence;
        if(names.length === 0){
          altSentence = 'Wir schlagen dir als Alternative aktuell keine weitere Box vor.';
        }else if(names.length === 1){
          altSentence = `Wir schlagen dir als Alternative die ${names[0]} vor.`;
        }else if(names.length === 2){
          altSentence = `Wir schlagen dir als Alternative die ${names[0]} oder die ${names[1]} vor.`;
        }else{
          const list = names.slice();
          const last = list.pop();
          altSentence = `Wir schlagen dir als Alternative die ${list.join(', die ')} oder die ${last} vor.`;
        }
        return `Hallo ${b.customer_name},

tut uns leid, aber unsere Musikboxen sind sehr gefragt 🔥

        Für deine Buchung (${displayId(b)}) ist die Musikbox ${b.box_name} für den Zeitraum ${range} leider nicht mehr verfügbar. ${altSentence}

Du kannst gerne direkt in unserem <a href="https://www.mietmichbox.de/buchungskalender" target="_blank" rel="noopener">Buchungskalender</a> eine neue Buchung mit einer anderen Musikbox oder zu einem anderen Zeitraum anfragen. Alternativ kannst du uns auch als Antwort auf diese E-Mail die alternative Musikbox oder den alternativen Zeitraum nennen, sodass wir deine Buchung aktualisieren können. Wir helfen dir gerne schnellstmöglich weiter.

Falls du noch offene Fragen hast, kannst du uns jederzeit kontaktieren.

Viele Grüße
Dein MietMichBox Team
www.mietmichbox.de

E-Mail: info@mietmichbox.de
Telefon: 01742015500`;
      }

      tplEditInfo(b){
        const start = new Date(b.start_date);
        const end = new Date(b.end_date);
        const validStart = !Number.isNaN(start.getTime());
        const validEnd = !Number.isNaN(end.getTime());
        const range = (validStart && validEnd)
          ? `${start.toLocaleDateString('de-DE')} – ${end.toLocaleDateString('de-DE')}`
          : `${b.start_date} – ${b.end_date}`;
        const price = Number(b.price_total ?? b.total_amount ?? 0);
        const priceLabel = Number.isFinite(price)
          ? price.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2})
          : (b.price_total ?? b.total_amount ?? '0');
        const statusLabel = this.translateStatus(b.status || 'pending');
        const name = b.customer_name || 'Kund*in';
        const email = b.customer_email || '–';
        const box = b.box_name || BOX_MAP[String(b.box_id)] || '—';
        const fulfillment = this.fulfillmentEmailLine(b);
        const instructions = this.fulfillmentInstructionText(b);
        return `Hallo ${name},

        wir haben Details in deiner Buchung (${displayId(b)}) aktualisiert.

Deine aktualisierte Buchung im Überblick:
👤 Name: ${name}
📧 E-Mail: ${email}
🎵 Musikbox: ${box}
🕰️ Zeitraum: ${range}
🚚 Abwicklung: ${fulfillment}
💶 Preis: ${priceLabel}€

Informationen für deine gewählte Abwicklung:
${instructions}

Bitte überprüfe einmal, ob wir deine Buchung korrekt hinterlegt haben.

Falls du noch offene Fragen hast, kannst du uns jederzeit kontaktieren.

Viele Grüße
Dein MietMichBox Team
www.mietmichbox.de

E-Mail: info@mietmichbox.de
Telefon: 01742015500`;
      }
    }

    injectAdminListCSS();
    global.MietMichBoxAdminList={ init:(opts)=>new AdminList(opts) };

  })(window);
  </script>

  <!-- ======================= INIT ======================= -->
  <script>
    document.addEventListener('DOMContentLoaded', async function(){
      try {
        await MMBAdminAuth.ensureSession();
      } catch (error) {
        const reason = error instanceof Error ? error : new Error(String(error));
        console.error('Admin-Authentifizierung konnte nicht geprüft werden.', reason);
      }

      try {
        MietMichBoxAdminList.init({ container:'#mmb-admin-list', locale:'de-DE', timezone:'Europe/Berlin' });
      } catch (error) {
        console.error('Admin-Buchungsliste konnte nicht initialisiert werden', error);
        const container = document.querySelector('#mmb-admin-list');
        if (container) {
          container.innerHTML = '<p class="mmb-error">Die Buchungsliste konnte nicht geladen werden. Bitte versuchen Sie es erneut oder wenden Sie sich an den Support.</p>';
        }
      }
    });
  </script>
</body>
</html>
