    note:'',
    totalSubline:'inkl. Abholung in Wesel, NRW',
    infoTitle:'Abholung in Wesel, NRW',
    infoHtml:`<p>📍 Wir stimmen den Treffpunkt in Wesel individuell mit dir ab.</p>
      <p>🕚 Abholung ab deinem Miettag um 11:00 Uhr möglich.</p>
      <p>🔁 Rückgabe am selben Ort (sofern nichts anderes vereinbart) bis 10:00 Uhr am Folgetag nach Mietende.</p>
      <p>😊 Melde dich gerne, falls du andere Zeiten brauchst – wir finden eine Lösung.</p>`
  },
  {
    id:'shipping',
    label:'Versand (ganz Deutschland)',
    shortLabel:'Versand',
    subLabel:'Express-Hin- & Rückversand inkl. QR-Code',
    displayTitle:'Versand',
    displayRegion:'ganz Deutschland 🇩🇪',
    displayPrice:'+ 80 €',
    priceDelta:80,
    addsToTotal:true,
    summaryLabel:'Versand (ganz Deutschland)',
    summaryValue:'+ 80 €',
    note:'',
    totalSubline:'inkl. Hin- & Rückversand',
    infoTitle:'Versand (ganz Deutschland)',
    infoHtml:`<p>🚚 Wir versenden deine Musikbox einen Tag vor Mietbeginn per Express, damit sie pünktlich ankommt.</p>
      <p>📦 Am letzten Miettag gibst du das Paket mit dem mitgelieferten QR-Code wieder auf – so ist es direkt am Folgetag bei uns.</p>
      <p>💶 Die Pauschale von 80 € deckt Hin- und Rückversand sowie den zusätzlichen Aufwand und Ausfalltage ab.</p>
      <p>✅ Du erhältst alle Versandinfos rechtzeitig per E-Mail.</p>`
  },
  {
    id:'delivery',
    label:'Lieferung (ganz NRW)',
    shortLabel:'Lieferung',
    subLabel:'Individuelles Angebot durch unser Team',
    displayTitle:'Lieferung',
    displayRegion:'ganz Nordrhein-Westfalen',
    displayPriceNote:'* Individuelles Preisangebot durch unser Team',
    priceDelta:0,
    addsToTotal:false,
    summaryLabel:'Lieferung (ganz NRW)',
    summaryValue:'individuell',
    note:'',
    totalLabel:'Vorläufig Gesamt',
    totalSubline:'zzgl. individuelle Lieferkosten',
    infoTitle:'Lieferung (ganz NRW)',
    infoHtml:`<p>🚗 Wir liefern dir die Musikbox persönlich innerhalb von NRW – auf Wunsch inkl. Aufbau & Abholung.</p>
      <p>💶 Die Kosten bestehen aus einer Grundpauschale plus einer Kilometerpauschale – daher berechnen wir den Preis individuell.</p>
      <p>✉️ Du erhältst nach deiner Anfrage ein persönliches Angebot mit allen Details.</p>
      <p>🤝 Gemeinsam finden wir die bequemste Lösung für dich.</p>`
  }
];

const FULFILLMENT_LOOKUP = Object.fromEntries(FULFILLMENT_OPTIONS.map(opt => [opt.id, opt]));

const Utils={
  MONTH_NAMES:['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'],
  DAY_NAMES:['Mo','Di','Mi','Do','Fr','Sa','So'],
  formatDate(d){const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),da=String(d.getDate()).padStart(2,'0'); return `${y}-${m}-${da}`;},
  formatMonthYear(d){return `${this.MONTH_NAMES[d.getMonth()]} ${d.getFullYear()}`;},
  startOfDay(d){const x=new Date(d); x.setHours(0,0,0,0); return x;},
  cmpDate(a,b){a=this.startOfDay(a).getTime(); b=this.startOfDay(b).getTime(); return a===b?0:(a<b?-1:1);},
  generateCalendarDays(cur){const y=cur.getFullYear(),m=cur.getMonth(),first=new Date(y,m,1),last=new Date(y,m+1,0);
    const start=(first.getDay()===0?6:first.getDay()-1), days=[], prevLast=new Date(y,m,0);
    for(let i=start-1;i>=0;i--){days.push({date:new Date(y,m-1,prevLast.getDate()-i),otherMonth:true});}
    for(let d=1; d<=last.getDate(); d++){days.push({date:new Date(y,m,d),otherMonth:false});}
    const total=Math.ceil(days.length/7)*7, fill=total-days.length;
    for(let d=1; d<=fill; d++){days.push({date:new Date(y,m+1,d),otherMonth:true});}
    return days;}
};
const EURO_FMT = new Intl.NumberFormat('de-DE');
const Euro={round:x=>Math.round(Number(x)||0), fmt:x=>`${EURO_FMT.format(Math.round(Number(x)||0))} €`};
const Percent={disp:p=>Math.round(Number(p)||0)};

/* ===== HTTP Helpers ===== */
function parseJsonLoose(txt){
  try { return JSON.parse(txt); } catch(e){}
  const first = txt.indexOf('{'); const last  = txt.lastIndexOf('}');
  if(first !== -1 && last !== -1 && last > first){
    const cand = txt.slice(first, last+1);
    try { return JSON.parse(cand); } catch(e){}
  }
  const m = txt.match(/\{[\s\S]*?"ok"\s*:\s*(true|false)[\s\S]*?\}/);
  if(m){ try { return JSON.parse(m[0]); } catch(e){} }
  throw new Error('Antwort ist kein valides JSON.\n\nAusschnitt:\n' + txt.slice(0, 200));
}
async function fetchText(url, opts){ const r=await fetch(url, opts||{}); const t=await r.text(); return {ok:r.ok,status:r.status,text:t}; }

/* ===== API Endpoints ===== */
const PRICING_URLS = [MMB_CONFIG.pricingUrl,'pricing.php','api/pricing.php'].filter(Boolean);
const BOOKING_URLS = [MMB_CONFIG.createUrl];

/* — Ableitungslogik: erzwinge Verfügbarkeit ja/nein — */
function deriveEnforcement(pr){
  const s = (pr && (pr.settings || (pr.pricing&&pr.pricing.settings))) || {};
  if (typeof s.enforce_availability === 'boolean') return s.enforce_availability;
  if (typeof s.availability_visible   === 'boolean') return s.availability_visible; // sichtbar => auch erzwingen
  if (typeof s.enforceAvailability    === 'boolean') return s.enforceAvailability;
  if (typeof s.allowOverlapWhenHidden === 'boolean') return !s.allowOverlapWhenHidden;
  return true; // Default: erzwingen
}

async function getPricing(){
  let last;
  for(const u of PRICING_URLS){
    try{
      const {status,text} = await fetchText(u, { headers:{'Accept':'application/json'} });
      const j = parseJsonLoose(text);
      if(j && j.ok === true) return j;
      last = new Error((j && j.error) ? j.error : ('HTTP '+status+' / ' + text.slice(0,160)));
    }catch(e){ last = e; }
  }
  throw last || new Error('Konnte Preise nicht laden');
}

/* ==== Senden: urlencoded (bevorzugt), Fallback JSON ==== */
async function sendBooking(url, payload){
  const makeUrlEnc = (p)=>{ const u=new URLSearchParams(); Object.entries(p).forEach(([k,v])=>u.append(k,String(v))); return u; };
  // 1) application/x-www-form-urlencoded
  const r1 = await fetchText(url, {
    method:'POST',
    body: makeUrlEnc(payload),
    headers:{'Content-Type':'application/x-www-form-urlencoded','Accept':'application/json'},
    credentials:'omit'
  });
  if (r1.ok){
    const j = parseJsonLoose(r1.text);
    if (j && j.ok===true) return j;
    throw new Error((j && j.error) ? j.error : ('HTTP '+r1.status+' / '+r1.text.slice(0,200)));
  }
  // 2) JSON Fallback
  const r2 = await fetchText(url, {
    method:'POST',
    body: JSON.stringify(payload),
    headers:{'Content-Type':'application/json','Accept':'application/json'},
    credentials:'omit'
  });
  if (r2.ok){
    const j = parseJsonLoose(r2.text);
    if (j && j.ok===true) return j;
    throw new Error((j && j.error) ? j.error : ('HTTP '+r2.status+' / '+r2.text.slice(0,200)));
  }
  throw new Error('HTTP '+r1.status+' / '+r1.text.slice(0,140));
}

/* ===== Kalender ===== */
class Calendar{
  constructor(container){
    this.root = typeof container==='string'? document.querySelector(container):container;
    this.state={month:new Date(), boxes:[], box:null, sel:{start:null,end:null}, pricing:null, enforceAvailability:true, summary:null, fulfillment:FULFILLMENT_OPTIONS[0]};
    this.dayElMap=new Map(); this.avgCache=null; this.infoOverlay=null;
    this.handleInfoKeyDown=this.handleInfoKeyDown.bind(this);
    this.init();
  }
  async init(){
    this.root.innerHTML=`
      <div class="mmb-widget">
        <div class="mmb-header">
          <div class="mmb-header-inner">
            <div class="mmb-section-title">Musikbox auswählen</div>
            <div class="mmb-box-buttons" role="radiogroup" aria-label="Musikbox auswählen"></div>
          </div>
        </div>
        <div class="mmb-content">
          <div class="mmb-calendar-wrap"><div class="cal" style="flex:1;"></div></div>
          <div class="mmb-side-wrap"><div class="side" style="flex:1"></div></div>
        </div>
      </div>`;
    const pr=await getPricing(); this.state.pricing=pr.pricing; this.state.enforceAvailability = deriveEnforcement(pr);
    const boxes=Object.entries(pr.pricing.boxes).map(([id,b])=>({id,name:b.name})).sort((a,b)=>Number(a.id)-Number(b.id));
    this.state.boxes=boxes; this.state.box=boxes[0];

    this.renderHeader(); this.renderCalendar(); this.renderSide(); this.wire();
  }

  getFulfillmentOption(id){
    return FULFILLMENT_LOOKUP[id] || FULFILLMENT_OPTIONS[0];
  }

  renderFulfillmentOptions(selected){
    const active = selected && selected.id ? selected : FULFILLMENT_OPTIONS[0];
    const group = FULFILLMENT_OPTIONS.map((opt, idx)=>{
      const isActive = opt.id === active.id;
      const title = opt.displayTitle || opt.label;
      const region = opt.displayRegion ? `<span class="mmb-fulfillment-region">${opt.displayRegion}</span>` : '';
      const price = opt.displayPrice ? `<span class="mmb-fulfillment-price">${opt.displayPrice}</span>` : '';
      const note = opt.displayPriceNote ? `<span class="mmb-fulfillment-price-note">${opt.displayPriceNote}</span>` : '';
      return `<label class="mmb-fulfillment-option ${isActive?'is-active':''}" data-fulfillment="${opt.id}">
                <input type="radio" name="fulfillment_method" value="${opt.id}" ${isActive?'checked':''} ${idx===0?'required':''}>
                <span class="mmb-fulfillment-label">${title}</span>
                ${region}
                ${price}
                ${note}
                <button type="button" class="mmb-fulfillment-info" data-act="fulfillment-info" data-id="${opt.id}" aria-label="Infos zu ${opt.label}">?</button>
              </label>`;
    }).join('');
    return `<div class="mmb-fulfillment-group" role="radiogroup" aria-label="Abwicklung auswählen">
      ${group}
    </div>`;
  }

  fulfillmentMeta(option){
    const opt = option || FULFILLMENT_OPTIONS[0];
    const addsToTotal = opt.addsToTotal !== false;
    const priceDelta = Number(opt.priceDelta||0);
    const summaryLabel = opt.summaryLabel || opt.label;
    const summaryValue = opt.summaryValue ?? (addsToTotal ? (priceDelta>0?`+${Euro.fmt(priceDelta)}`:'gratis') : 'gratis');
    const note = opt.note || '';
    const totalLabel = opt.totalLabel || (addsToTotal ? 'Gesamt' : 'Vorläufig Gesamt');
    const totalSubline = opt.totalSubline || '';
    const shortLabel = opt.shortLabel || summaryLabel;
    return {addsToTotal, priceDelta, summaryLabel, summaryValue, note, totalLabel, totalSubline, shortLabel};
  }

  buildRangeSummary(sum, option){
    const meta = this.fulfillmentMeta(option);
    const shipping = meta.addsToTotal ? meta.priceDelta : 0;
    const totalWithShipping = sum.total + shipping;
    const totalRow = `<div class="mmb-total"><div class="mmb-total-label"><span class="label">${meta.totalLabel}</span>${meta.totalSubline?`<span class="mmb-total-sub">${meta.totalSubline}</span>`:''}</div><span class="value">${Euro.fmt(totalWithShipping)}</span></div>`;
    const lines = [
      `<div class="mmb-price-line"><span>Grundpreis </span><span>${Euro.fmt(sum.original)}</span></div>`,
      `<div class="mmb-price-line"><span>Langzeitrabatt (${sum.discountPercentDisplay}%)</span><span>–${Euro.fmt(sum.discountAmount)}</span></div>`,
      `<div class="mmb-price-line"><span>${meta.summaryLabel}</span><span>${meta.summaryValue}</span></div>`,
      `<div class="mmb-hr"></div>`,
      totalRow,
      `<div class="mmb-price-line"><span class="mmb-price-small">Ø pro Tag</span><span class="mmb-price-small">${Euro.fmt(sum.avgPerDay)}</span></div>`,
      `<div class="mmb-price-line"><span class="mmb-price-small">Kaution</span><span class="mmb-price-small">gratis</span></div>`
    ];
    if(meta.note){ lines.push(`<div class="mmb-price-note">${meta.note}</div>`); }
    return {
      html:`<div class="mmb-price-summary">${lines.join('')}</div>`,
      payload:{
        total: totalWithShipping,
        deposit: 0,
        original: sum.original,
        days: sum.days,
        base_total: sum.total,
        shipping_delta: shipping,
        fulfillment_id: option.id,
        fulfillment_label: meta.shortLabel,
        fulfillment_note: meta.note,
        fulfillment_price_delta: meta.priceDelta,
        fulfillment_adds_to_total: meta.addsToTotal
      }
    };
  }

  buildSingleSummary(base, option){
    const meta = this.fulfillmentMeta(option);
    const shipping = meta.addsToTotal ? meta.priceDelta : 0;
    const totalWithShipping = base + shipping;
    const totalRow = `<div class="mmb-total"><div class="mmb-total-label"><span class="label">${meta.totalLabel}</span>${meta.totalSubline?`<span class="mmb-total-sub">${meta.totalSubline}</span>`:''}</div><span class="value">${Euro.fmt(totalWithShipping)}</span></div>`;
    const lines = [
      `<div class="mmb-price-line"><span>Grundpreis </span><span>${Euro.fmt(base)}</span></div>`,
      `<div class="mmb-price-line"><span>Langzeitrabatt (0%)</span><span>–${Euro.fmt(0)}</span></div>`,
      `<div class="mmb-price-line"><span>${meta.summaryLabel}</span><span>${meta.summaryValue}</span></div>`,
      `<div class="mmb-hr"></div>`,
      totalRow,
      `<div class="mmb-price-line"><span class="mmb-price-small">Ø pro Tag</span><span class="mmb-price-small">${Euro.fmt(base)}</span></div>`,
      `<div class="mmb-price-line"><span class="mmb-price-small">Kaution</span><span class="mmb-price-small">gratis</span></div>`
    ];
    if(meta.note){ lines.push(`<div class="mmb-price-note">${meta.note}</div>`); }
    return {
      html:`<div class="mmb-price-summary">${lines.join('')}</div>`,
      payload:{
        total: totalWithShipping,
        deposit: 0,
        original: base,
        days: 1,
        base_total: base,
        shipping_delta: shipping,
        fulfillment_id: option.id,
        fulfillment_label: meta.shortLabel,
        fulfillment_note: meta.note,
        fulfillment_price_delta: meta.priceDelta,
        fulfillment_adds_to_total: meta.addsToTotal
      }
    };
  }

  showFulfillmentInfo(option){
    if(!option) return;
    this.hideFulfillmentInfo();
    const overlay=document.createElement('div'); overlay.className='mmb-info-overlay';
    overlay.innerHTML=`<div class="mmb-info-card" role="dialog" aria-modal="true">
        <button type="button" class="mmb-info-close" data-close aria-label="Info schließen">×</button>
        <h4>${option.infoTitle || option.label}</h4>
        ${option.infoHtml || ''}
      </div>`;
    const close=()=>this.hideFulfillmentInfo();
    overlay.addEventListener('click',ev=>{ if(ev.target===overlay) close(); });
    const closeBtn=overlay.querySelector('[data-close]');
    if(closeBtn){ closeBtn.addEventListener('click',close); }
    document.body.appendChild(overlay);
    this.infoOverlay=overlay;
    document.addEventListener('keydown',this.handleInfoKeyDown);
    setTimeout(()=>{ try{ closeBtn?.focus(); }catch(e){} }, 50);
  }

  hideFulfillmentInfo(){
    if(this.infoOverlay){
      document.removeEventListener('keydown',this.handleInfoKeyDown);
      this.infoOverlay.remove();
      this.infoOverlay=null;
    }
  }

  handleInfoKeyDown(ev){
    if(ev.key==='Escape'){ this.hideFulfillmentInfo(); }
  }

  getBoxPricing(id){ return this.state?.pricing?.boxes?.[id]||null; }
  baseDayPrice(id, date){ const bp=this.getBoxPricing(id); const w=['so','mo','di','mi','do','fr','sa'][date.getDay()]; return Number(bp?.prices?.[w]||0); }
  discountExact(days){ const m=this.state?.pricing?.discountsByDay||{}; return days>=30?Number(m[30]||0):Number(m[days]||0); }
  sumOriginal(id,s,e){ let sum=0; for(let d=new Date(s); d<=e; d.setDate(d.getDate()+1)){ sum+=this.baseDayPrice(id,d); } return sum; }
  pricedTotal(id,s,e){
    const days=this.days(s,e), orig=this.sumOriginal(id,s,e), pct=this.discountExact(days);
    const total=Euro.round(orig*(1-pct/100));
    return {days,original:orig,total,discountPercentExact:pct,discountPercentDisplay:Percent.disp(pct),discountAmount:orig-total,avgPerDay:Euro.round(total/days)};
  }
  marginalOneDay(id, start, day){
    const prev=new Date(day); prev.setDate(prev.getDate()-1);
    const a=this.pricedTotal(id,start,day).total;
    const b=this.pricedTotal(id,start,prev).total;
    return Math.max(0, Euro.round(a-b));
  }

  renderHeader(){
    const group=this.root.querySelector('.mmb-header .mmb-box-buttons');
    if(!group) return;
    const btns=this.state.boxes.map(b=>`<button class="mmb-box-btn ${this.state.box?.id===b.id?'mmb-box-btn--active':''}" data-act="box" data-id="${b.id}" aria-pressed="${this.state.box?.id===b.id}">${b.name}</button>`).join('');
    group.innerHTML=btns;
  }

  renderCalendar(){
    const host=this.root.querySelector('.cal');
    if(!host) return;
    const days=Utils.generateCalendarDays(this.state.month);
    const selectedFulfillment=this.getFulfillmentOption(this.state.fulfillment?.id);
    this.state.fulfillment=selectedFulfillment;
    const fulfillmentMarkup=this.renderFulfillmentOptions(selectedFulfillment);
    host.innerHTML=`
      <div class="mmb-calendar-meta">
        <div class="mmb-section-title">Zeitraum auswählen</div>
        <div class="mmb-nav">
          <button class="mmb-nav-btn" data-act="prev" aria-label="Vorheriger Monat">←</button>
          <div class="mmb-month-title">${Utils.formatMonthYear(this.state.month)}</div>
          <button class="mmb-nav-btn" data-act="next" aria-label="Nächster Monat">→</button>
        </div>
      </div>
      <div class="mmb-calendar">
        <div class="mmb-calendar-header">${Utils.DAY_NAMES.map(d=>`<div class="mmb-day-header">${d}</div>`).join('')}</div>
        <div class="mmb-calendar-body">
          ${days.map(day=>{
            const key=Utils.formatDate(day.date);
            const other=day.otherMonth?' mmb-day--other-month':'';
            const blocked=(day.date<new Date().setHours(0,0,0,0))?' mmb-day--blocked':'';
            return `<div class="mmb-day${other}${blocked}" data-date="${key}" data-price="" data-badge="">
                      <span class="num">${day.date.getDate()}</span>
                      <button class="mmb-pill-add" type="button" data-act="extend" data-date="${key}" aria-label="Zeitraum verlängern">+</button>
                    </div>`;
          }).join('')}
        </div>
      </div>
      <div class="mmb-fulfillment-block">
        <div class="mmb-section-title">Abwicklung auswählen</div>
        ${fulfillmentMarkup}
      </div>`;
    this.dayElMap.clear();
    host.querySelectorAll('.mmb-day[data-date]').forEach(el=>this.dayElMap.set(el.dataset.date,el));
    this.updateVisuals();
  }

  renderSide(){
    const s=this.state.sel.start, e=this.state.sel.end; const hasRange=!!(s&&e);
    const selectedFulfillment=this.getFulfillmentOption(this.state.fulfillment?.id);
    this.state.fulfillment=selectedFulfillment;
    let html=`<div class="mmb-booking-form"><h3 style="margin:0;font-weight:600;">Buchungsanfrage</h3>`;

    let summaryHtml='';
    let summaryPayload=null;

    if(hasRange){
      const sum=this.pricedTotal(this.state.box.id,s,e);
      this.avgCache=sum.avgPerDay;
      const summary=this.buildRangeSummary(sum, selectedFulfillment);
      summaryHtml=summary.html;
      summaryPayload=summary.payload;
    }else if(s){
      const base=this.baseDayPrice(this.state.box.id,s);
      const summary=this.buildSingleSummary(base, selectedFulfillment);
      summaryHtml=summary.html;
      summaryPayload=summary.payload;
      this.avgCache=null;
    }else{
      summaryHtml=`<div class="mmb-price-summary mmb-price-summary--empty">Bitte Zeitraum wählen</div>`;
      this.avgCache=null;
    }

    this.state.summary = summaryPayload;
    if(summaryHtml) html+=summaryHtml;

    html+=`<form data-act="submit">
      <label>Name *<br><input class="mmb-input" name="customer_name" required></label><br>
      <label>E-Mail *<br><input type="email" class="mmb-input" name="customer_email" required></label><br>
      <label>Telefon<br><input class="mmb-input" name="customer_phone"></label><br>
      <label>Anmerkungen<br><textarea class="mmb-input" name="note" style="min-height:70px;"></textarea></label><br>
      <div class="mmb-form-actions">
        <label class="mmb-terms"><input type="checkbox" name="accept_terms" required> Ich akzeptiere <a href="https://www.mietmichbox.de/allgemeine-geschaftsbedingungen" target="_blank" rel="noopener">AGB</a> & <a href="https://www.mietmichbox.de/datenschutzerklarung" target="_blank" rel="noopener">Datenschutz</a>*</label>
        <button class="mmb-btn" ${s?'':'disabled'}>Buchungsanfrage senden</button>
      </div>
    </form>
    <div style="margin-top:6px;color:#cfcfcf;font-size:.9rem;">${
      hasRange?`${s.toLocaleDateString('de-DE')} – ${e.toLocaleDateString('de-DE')} (${this.pricedTotal(this.state.box.id,s,e).days} Tage)`
      : (s?`${s.toLocaleDateString('de-DE')} (Start gewählt)`:``)
    }</div></div>`;
    this.root.querySelector('.side').innerHTML=html;
  }

  /* === Visuals === */
  updateVisuals(){
    this.dayElMap.forEach(el=>{
      el.classList.remove('mmb-day--in-range','mmb-day--selected');
      el.setAttribute('data-price',''); el.setAttribute('data-badge',''); el.removeAttribute('data-extend');
    });

    const s=this.state.sel.start, e=this.state.sel.end;
    const today=Utils.startOfDay(new Date());
    const cmp=(a,b)=>Utils.cmpDate(a,b);

    // Grundpreise
    this.dayElMap.forEach((el,key)=>{
      const [Y,M,D]=key.split('-').map(Number); const d=Utils.startOfDay(new Date(Y,M-1,D));
      if(el.classList.contains('mmb-day--blocked') || d<today){ el.setAttribute('data-price','—'); return; }
      el.setAttribute('data-price', Euro.fmt(this.baseDayPrice(this.state.box.id,d)));
    });

    if(!s) return;

    // nur Start
    if(s && !e){
      this.setBadge(s,'Start'); this.markRange(s,s);
      this.dayElMap.forEach((el,key)=>{
        const [Y,M,D]=key.split('-').map(Number); const d=Utils.startOfDay(new Date(Y,M-1,D));
        if(cmp(d,s)>0 && !el.classList.contains('mmb-day--blocked')){
          const add=this.marginalOneDay(this.state.box.id,s,d);
          el.setAttribute('data-price', add>0?`+${Euro.round(add)}€`:'—');
        }
      });
      return;
    }

    // Start & Ende
    if(s && e){
      this.setBadge(s,'Start'); this.setBadge(e,'Ende'); this.markRange(s,e);
      const avg = this.avgCache ?? this.pricedTotal(this.state.box.id,s,e).avgPerDay;
      this.forEachInRange(s,e, el=>{ el.setAttribute('data-price',`Ø ${Euro.round(avg)}€`); });
      this.dayElMap.forEach((el,key)=>{
        const [Y,M,D]=key.split('-').map(Number); const d=Utils.startOfDay(new Date(Y,M-1,D));
        if(cmp(d,e)>0 && !el.classList.contains('mmb-day--blocked')){
          const add=this.marginalOneDay(this.state.box.id,s,d);
          el.setAttribute('data-price', add>0?`+${Euro.round(add)}€`:'—');
          el.setAttribute('data-extend','1');
        }
      });
    }
  }

  setBadge(date,label){ const k=Utils.formatDate(date); const el=this.dayElMap.get(k); if(el) el.setAttribute('data-badge',label||''); }
  markRange(s,e){
    const cmp=(a,b)=>Utils.cmpDate(a,b);
    this.dayElMap.forEach((el,key)=>{
      const [Y,M,D]=key.split('-').map(Number); const d=Utils.startOfDay(new Date(Y,M-1,D));
      if(cmp(d,s)>=0 && cmp(d,e)<=0){ el.classList.add('mmb-day--in-range'); }
      if(cmp(d,s)===0 || cmp(d,e)===0){ el.classList.add('mmb-day--selected'); }
    });
  }

  /* === Events === */
  wire(){
    this.root.addEventListener('click',e=>{
      const infoBtn = e.target.closest('[data-act="fulfillment-info"]');
      if(infoBtn){
        e.preventDefault();
        const opt=this.getFulfillmentOption(infoBtn.dataset.id);
        this.showFulfillmentInfo(opt);
        return;
      }
      const nav = e.target.closest('[data-act="prev"],[data-act="next"],[data-act="box"]');
      if(nav){
        const act=nav.dataset.act;
        if(act==='prev'){ this.changeMonth(-1); return; }
        if(act==='next'){ this.changeMonth(1); return; }
        if(act==='box'){ const b=this.state.boxes.find(x=>x.id===nav.dataset.id); this.state.box=b; this.state.sel={start:null,end:null}; this.avgCache=null; this.renderHeader(); this.renderCalendar(); this.renderSide(); return; }
      }
      const add = e.target.closest('[data-act="extend"]');
      if(add){
        const key = add.dataset.date;
        if(this.state.sel.start && this.state.sel.end){
          const [Y,M,D]=key.split('-').map(Number); const target=Utils.startOfDay(new Date(Y,M-1,D));
          if(Utils.cmpDate(target,this.state.sel.end)>0){
            this.state.sel.end=target; this.renderSide(); this.updateVisuals();
          }
        }
        return;
      }
      const day = e.target.closest('.mmb-day[data-date]');
      if(day){ this.pick(day.dataset.date); }
    });

    this.root.addEventListener('change',e=>{
      const radio = e.target.closest('input[name="fulfillment_method"]');
      if(radio){
        this.state.fulfillment = this.getFulfillmentOption(radio.value);
        this.renderCalendar();
        this.renderSide();
      }
    });

    // Submit
    this.root.addEventListener('submit', async (e)=>{
      if(!e.target.matches('form[data-act="submit"]')) return;
      e.preventDefault();
      const fd=new FormData(e.target);
      const data=Object.fromEntries(fd.entries());
      if(!data.customer_name || !data.customer_email || !data.accept_terms){ return this.modal('Bitte prüfen','Bitte alle Pflichtfelder ausfüllen und AGB/Datenschutz akzeptieren.'); }
      if(!this.state.sel.start){ return this.modal('Zeitraum fehlt','Bitte einen Zeitraum im Kalender wählen.'); }

      const start=this.state.sel.start, end=this.state.sel.end || this.state.sel.start;

      // >>> NEU: Summen aus dem State (Fallback: on-the-fly berechnen)
      const summaryInfo = this.state.summary;
      const fallbackSum = this.pricedTotal(this.state.box.id, start, end);
      const fulfillmentFromState = this.getFulfillmentOption(summaryInfo?.fulfillment_id || this.state.fulfillment?.id);
      const baseTotal = Number(summaryInfo?.base_total ?? fallbackSum?.total ?? 0);
      const shippingDelta = Number(summaryInfo?.shipping_delta ?? (fulfillmentFromState.addsToTotal !== false ? (fulfillmentFromState.priceDelta||0) : 0));
      const total_amount = Number(summaryInfo?.total ?? (baseTotal + shippingDelta));
      const deposit_eur  = Number(summaryInfo?.deposit ?? 0);
      const fulfillmentMethod = summaryInfo?.fulfillment_id || fulfillmentFromState.id;
      const fulfillmentLabel = summaryInfo?.fulfillment_label || fulfillmentFromState.shortLabel || fulfillmentFromState.label;
      const fulfillmentPriceDelta = Number(summaryInfo?.fulfillment_price_delta ?? fulfillmentFromState.priceDelta ?? 0);
      const fulfillmentNote = summaryInfo?.fulfillment_note || fulfillmentFromState.note || '';

      const payload={
        box_id:Number(this.state.box.id),
        start_date:Utils.formatDate(start),
        end_date:Utils.formatDate(end),
        customer_name:(data.customer_name||'').trim(),
        customer_email:(data.customer_email||'').trim(),
        customer_phone:(data.customer_phone||'').trim(),
        note:(data.note||'').trim(),
        /* Overlap: wenn Verfügbarkeit NICHT erzwungen wird, darf trotzdem angefragt werden */
        force: this.state.enforceAvailability ? 0 : 1,

        // >>> NEU: Preis an Backend übergeben (als reine Zahlen)
        total_amount: total_amount,
        deposit_eur:  deposit_eur,
        fulfillment_method: fulfillmentMethod,
        fulfillment_label: fulfillmentLabel,
        fulfillment_price_delta: fulfillmentPriceDelta
      };
      if(fulfillmentNote){ payload.fulfillment_note = fulfillmentNote; }

      const btn=e.target.querySelector('button'); const orig=btn.textContent; btn.disabled=true; btn.textContent='Senden…';
      try{
        const res=await sendBooking(MMB_CONFIG.createUrl, payload);
        const dispId = res?.booking?.display_id ? String(res.booking.display_id) : '–';
        this.modal('Buchungsanfrage gesendet','Danke! Deine Anfrage ist eingegangen.\n\nBuchungs-ID: '+dispId);
        e.target.reset(); this.state.sel={start:null,end:null}; this.avgCache=null; this.state.summary=null; this.state.fulfillment=FULFILLMENT_OPTIONS[0]; this.hideFulfillmentInfo();
        this.renderCalendar(); this.renderSide(); this.updateVisuals();
      }catch(err){
        console.error(err);
        this.modal('Fehler beim Senden', (err && err.message)? err.message : String(err));
      }finally{ btn.disabled=false; btn.textContent=orig; }
    });
  }

  pick(key){
    const [Y,M,D]=key.split('-').map(Number); const date=Utils.startOfDay(new Date(Y,M-1,D));
    const today=Utils.startOfDay(new Date()); if(date<today) return;
    let {start,end}=this.state.sel;
    if(start && end){ this.state.sel={start:date,end:null}; this.avgCache=null; this.state.summary=null; this.renderSide(); this.updateVisuals(); return; }
    if(!start){ this.state.sel={start:date,end:null}; this.avgCache=null; this.state.summary=null; this.renderSide(); this.updateVisuals(); return; }
    const cmp=Utils.cmpDate(date,start);
    if(cmp===0){ this.state.sel={start:start,end:start}; this.renderSide(); this.updateVisuals(); return; }
    if(cmp>0){ this.state.sel={start:start,end:date}; this.renderSide(); this.updateVisuals(); return; }
    this.state.sel={start:date,end:null}; this.avgCache=null; this.state.summary=null; this.renderSide(); this.updateVisuals();
  }

  changeMonth(delta){
    const m=new Date(this.state.month); m.setMonth(m.getMonth()+delta);
    const today=new Date(); if(m<new Date(today.getFullYear(),today.getMonth(),1)) return;
    this.state.month=m; this.renderHeader(); this.renderCalendar(); this.renderSide();
  }

  days(s,e){ const S=new Date(s.getFullYear(),s.getMonth(),s.getDate()), E=new Date(e.getFullYear(),e.getMonth(),e.getDate()); return Math.floor((E-S)/86400000)+1; }

  forEachInRange(s,e,cb){
    const cmp=(a,b)=>Utils.cmpDate(a,b);
    this.dayElMap.forEach((el,key)=>{
      const [Y,M,D]=key.split('-').map(Number); const d=Utils.startOfDay(new Date(Y,M-1,D));
      if(cmp(d,s)>=0 && cmp(d,e)<=0){ cb(el); }
    });
  }

  modal(title,text){
    document.getElementById('mmb-modal-title').textContent=title;
    document.getElementById('mmb-modal-text').textContent=text;
    document.getElementById('mmb-modal').style.display='flex';
  }
}
document.getElementById('mmb-modal-close').addEventListener('click',()=>{document.getElementById('mmb-modal').style.display='none';});
function start(){ new Calendar('#mmb-customer'); }
document.readyState==='loading'?document.addEventListener('DOMContentLoaded',start):start();
</script>
</body>
