<script>
/* ========= KONFIG ========= */
const MMB_CONFIG = {
  pricingUrl: 'https://firebrick-squirrel-568721.hostingersite.com/pricing.php',
  createUrl:  'https://firebrick-squirrel-568721.hostingersite.com/create_booking.php'
};
/* ========================= */

const FULFILLMENT_OPTIONS = [
  {
    id:'pickup',
    label:'Abholung in Wesel, NRW',
    shortLabel:'Abholung',
    subLabel:'Kostenfreie Selbstabholung vor Ort',
    displayTitle:'Abholung',
    displayRegion:'in Wesel, NRW',
    displayPrice:'+ 0 €',
    priceDelta:0,
    addsToTotal:true,
    summaryLabel:'Abholung in Wesel, NRW',
